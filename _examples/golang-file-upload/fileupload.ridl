webrpc = v1

name = file-upload
version = v1.0.0
basepath = /rpc

service FileService
  - UploadAvatar(userId: uint64, avatar: file) => (size: uint64)
  - UploadAttachments(userId: uint64, attachments: []file) => (count: uint32)
  - DownloadAvatar(userId: uint64) => (avatar: file)

  # StampAvatar returns the user's stored avatar with the uploaded stamp
  # appended to its content — a combined upload + download method.
  - StampAvatar(userId: uint64, stamp: file) => (stamped: file)

  # ListAvatars returns the ids of users with a stored avatar — a plain JSON
  # method on a service that also transfers files.
  - ListAvatars() => (userIds: []uint64)
