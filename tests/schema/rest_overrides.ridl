webrpc = v1

name = RestOverrides
version = v1.0.0
basepath = /

# Go-only REST cases: go.field.type overrides, string and float32 params, and the root route.
service RestOverrides
  - Index()
      + GET /
  - Search(SearchRequest) => (SearchResponse)
      + GET /by/{lbl}
  - Scale(factor: float32) => (value: float32)
      + GET /scale/{factor}

struct SearchRequest
  - label: string
    + json = lbl
    + go.field.name = Key
    + go.field.type = types.Label
    + go.type.import = github.com/webrpc/webrpc/tests/overrides/types
  - tag?: string
    + json = t
    + go.field.type = types.Tag
    + go.type.import = github.com/webrpc/webrpc/tests/overrides/types
  - limit: uint32
    + json = n

struct SearchResponse
  - echo: string
