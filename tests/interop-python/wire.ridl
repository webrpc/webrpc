webrpc = v1

name = t
version = v0.1.0
basepath = /rpc

enum Kind: uint32
  - Admin
    + json = ADMIN
  - User

enum Country: string
  - CA = "Canada"
  - US = "USA"

struct Data
  - k: Kind
  - c: Country

struct FlattenRequest
  - a: string

struct FlattenResponse
  - b: string

service Wire
  - Flatten(FlattenRequest) => (FlattenResponse)
