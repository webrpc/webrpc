{{- /* pyStr renders a Python string literal. */ -}}
{{- define "pyStr" -}}
{{ printf "%q" (printf "%v" .) }}
{{- end -}}

{{- define "helpers" -}}

def _to_value(v: Any) -> Any:
    if v is None:
        return None
    if isinstance(v, datetime):
        if v.tzinfo is None:
            v = v.replace(tzinfo=timezone.utc)
        return v.isoformat()
    if isinstance(v, Enum):
        return v.value
    if isinstance(v, list):
        return [_to_value(x) for x in v]
    if isinstance(v, dict):
        return {_to_value(k): _to_value(x) for k, x in v.items()}
    if hasattr(v, "to_dict"):
        return v.to_dict()
    return v


def _as_list(v: Any) -> list:
    if v is None:
        return []
    if isinstance(v, list):
        return v
    raise TypeError(f"expected a list, got {type(v).__name__}")


def _as_dict(v: Any) -> dict:
    if v is None:
        return {}
    if isinstance(v, dict):
        return v
    raise TypeError(f"expected an object, got {type(v).__name__}")


def _required(data: dict[str, Any], key: str) -> Any:
    if key not in data:
        raise ValueError(f"missing required value: {key}")
    value = data[key]
    if value is None:
        raise ValueError(f"required value is null: {key}")
    return value


def _check_int(v: Any) -> Any:
    if v is None or (isinstance(v, int) and not isinstance(v, bool)):
        return v
    raise TypeError(f"expected an integer, got {type(v).__name__}")


def _check_float(v: Any) -> Any:
    if v is None or (isinstance(v, (int, float)) and not isinstance(v, bool)):
        return v
    raise TypeError(f"expected a number, got {type(v).__name__}")


def _check_bool(v: Any) -> Any:
    if v is None or isinstance(v, bool):
        return v
    raise TypeError(f"expected a boolean, got {type(v).__name__}")


def _check_str(v: Any) -> Any:
    if v is None or isinstance(v, str):
        return v
    raise TypeError(f"expected a string, got {type(v).__name__}")


def _parse_datetime(v: Any) -> datetime:
    if isinstance(v, datetime):
        return v
    if isinstance(v, str) and v.endswith("Z"):
        v = v[:-1] + "+00:00"
    return datetime.fromisoformat(v)


def _parse_bigint(v: Any) -> int:
    # webrpc transports bigint as a decimal string; tolerate an integer JSON number too.
    if isinstance(v, bool):
        raise TypeError(f"expected a bigint, got {type(v).__name__}")
    if isinstance(v, int):
        return v
    if isinstance(v, str):
        try:
            return int(v, 10)
        except ValueError as err:
            raise TypeError(f"expected a bigint, got {v!r}") from err
    raise TypeError(f"expected a bigint, got {type(v).__name__}")


def _bigint_to_value(v: Any) -> Any:
    # webrpc expects bigint on the wire as a decimal string.
    return None if v is None else str(v)
{{- end -}}
