{{- define "type" -}}
{{- /* Renders a webrpc type as a Python type annotation. */ -}}
{{- $type := .Type -}}
{{- $typeMap := .TypeMap -}}
{{- if isMapType $type -}}
dict[{{template "type" dict "Type" (mapKeyType $type) "TypeMap" $typeMap}}, {{template "type" dict "Type" (mapValueType $type) "TypeMap" $typeMap}}]
{{- else if isListType $type -}}
list[{{template "type" dict "Type" (listElemType $type) "TypeMap" $typeMap}}]
{{- else if isCoreType $type -}}
{{get $typeMap $type}}
{{- else -}}
{{$type}}
{{- end -}}
{{- end -}}
