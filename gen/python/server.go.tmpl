{{- define "server" -}}
{{- $typeMap := .TypeMap -}}
{{- $aliasMap := .AliasMap -}}
{{- $nullableStructs := .NullableStructs -}}
{{- $basepath := .BasePath -}}
{{- $services := .Services -}}
{{- $kw := list "False" "None" "True" "and" "as" "assert" "async" "await" "break" "class" "continue" "def" "del" "elif" "else" "except" "finally" "for" "from" "global" "if" "import" "in" "is" "lambda" "nonlocal" "not" "or" "pass" "raise" "return" "try" "while" "with" "yield" "self" -}}
{{- if $services}}

def _status_line(status: int) -> str:
    try:
        return f"{status} {_HTTPStatus(status).phrase}"
    except ValueError:
        return f"{status} Unknown"
{{- end}}
{{- range $_, $service := $services}}


class {{$service.Name}}(Protocol):
{{- range $_, $method := $service.Methods}}
    def {{template "pyMethod" $method}}(self{{range $_, $in := $method.Inputs}}{{$ik := $in.Name}}{{$ip := $ik}}{{if has $ik $kw}}{{$ip = printf "%s_" $ik}}{{end}}, {{$ip}}: {{if $in.Optional}}Optional[{{end}}{{template "type" dict "Type" $in.Type "TypeMap" $typeMap}}{{if $in.Optional}}]{{end}}{{end}}) -> {{template "methodReturn" dict "Method" $method "TypeMap" $typeMap}}:
        ...
{{- end}}


class {{$service.Name}}Server:
    """Framework-agnostic WSGI application that serves a {{$service.Name}} implementation."""

    def __init__(self, service: "{{$service.Name}}"):
        self._service = service
        self._routes = {
{{- range $_, $method := $service.Methods}}
            {{template "pyStr" (printf "%s%s/%s" $basepath $service.Name $method.Name)}}: self._rpc_{{snakeCase $method.Name}},
{{- end}}
        }

    def __call__(self, environ, start_response):
        if environ.get("REQUEST_METHOD") != "POST":
            return self._error(start_response, WebrpcBadMethod(), [("Allow", "POST")])
        handler = self._routes.get(environ.get("PATH_INFO", ""))
        if handler is None:
            return self._error(start_response, WebrpcBadRoute())
        content_type = environ.get("CONTENT_TYPE", "").split(";")[0].strip().lower()
        if content_type != "application/json":
            return self._error(start_response, WebrpcBadRequest(message="Content-Type must be application/json"))
        length = environ.get("CONTENT_LENGTH")
        if length:
            try:
                length = int(length)
            except (TypeError, ValueError):
                return self._error(start_response, WebrpcBadRequest(message="invalid Content-Length"))
            raw = environ["wsgi.input"].read(length)
        else:
            raw = environ["wsgi.input"].read()
        try:
            data = json.loads(raw) if raw else {}
        except (json.JSONDecodeError, UnicodeDecodeError):
            return self._error(start_response, WebrpcBadRequest(message="invalid JSON body"))
        if data is None:
            data = {}
        if not isinstance(data, dict):
            return self._error(start_response, WebrpcBadRequest(message="request body must be a JSON object"))
        try:
            return self._respond(start_response, 200, handler(data))
        except WebRPCError as err:
            return self._error(start_response, err)
        except Exception as err:
            return self._error(start_response, WebrpcEndpoint(cause=str(err)))

    def _headers(self, body: bytes):
        return [
            ("Content-Type", "application/json"),
            ("Content-Length", str(len(body))),
            ("Webrpc", WEBRPC_HEADER_VALUE),
        ]

    def _respond(self, start_response, status: int, payload: dict[str, Any]):
        body = json.dumps(payload).encode("utf-8")
        start_response(_status_line(status), self._headers(body))
        return [body]

    def _error(self, start_response, err: "WebRPCError", extra_headers=None):
        body = json.dumps(err.to_dict()).encode("utf-8")
        headers = self._headers(body)
        if extra_headers:
            headers.extend(extra_headers)
        start_response(_status_line(err.status), headers)
        return [body]
{{- range $_, $method := $service.Methods}}

    def _rpc_{{snakeCase $method.Name}}(self, data: dict[str, Any]) -> dict[str, Any]:
{{- if $method.Inputs}}
        try:
            args = {
{{- if $method.Succinct}}
{{- $in := index $method.Inputs 0}}{{$ik := $in.Name}}{{$ip := $ik}}{{if has $ik $kw}}{{$ip = printf "%s_" $ik}}{{end}}
                {{template "pyStr" $ip}}: {{template "fromValue" dict "Type" $in.Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" "data"}},
{{- else}}
{{- range $_, $in := $method.Inputs}}
{{- $ik := $in.Name -}}{{- $ip := $ik -}}{{- if has $ik $kw -}}{{- $ip = printf "%s_" $ik -}}{{- end}}
                {{template "pyStr" $ip}}: {{if $in.Optional}}None if data.get({{template "pyStr" $ik}}) is None else {{end}}{{template "fromValue" dict "Type" $in.Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" (ternary (or $in.Optional (hasKey $nullableStructs (printf "%v" $in.Type))) (printf "data.get(%q)" $ik) (printf "_required(data, %q)" $ik))}},
{{- end}}
{{- end}}
            }
        except (ValueError, TypeError, KeyError, AttributeError) as err:
            raise WebrpcBadRequest(cause=f"invalid request: {err}") from err
{{- end}}
        result = self._service.{{template "pyMethod" $method}}({{if $method.Inputs}}**args{{end}})
{{- if eq (len $method.Outputs) 0}}
        return {}
{{- else if $method.Succinct}}
{{- $out := index $method.Outputs 0}}
        return {{template "toValue" dict "Type" $out.Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" "result"}}
{{- else if eq (len $method.Outputs) 1}}
{{- range $_, $out := $method.Outputs}}
{{- if $out.Optional}}
        if result is None:
            return {}
{{- end}}
        return { {{- template "pyStr" $out.Name}}: {{template "toValue" dict "Type" .Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" "result"}}}
{{- end}}
{{- else}}
        out: dict[str, Any] = {
{{- range $i, $out := $method.Outputs}}{{if not $out.Optional}}
            {{template "pyStr" $out.Name}}: {{template "toValue" dict "Type" $out.Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" (printf "result[%d]" $i)}},
{{- end}}{{end}}
        }
{{- range $i, $out := $method.Outputs}}{{if $out.Optional}}
        if result[{{$i}}] is not None:
            out[{{template "pyStr" $out.Name}}] = {{template "toValue" dict "Type" $out.Type "TypeMap" $typeMap "AliasMap" $aliasMap "Var" (printf "result[%d]" $i)}}
{{- end}}{{end}}
        return out
{{- end}}
{{- end}}
{{- end}}
{{- end -}}
