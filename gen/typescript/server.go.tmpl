{{- define "server" -}}

{{- $basepath := .BasePath -}}
{{- $services := .Services -}}
{{- $typeMap := .TypeMap -}}
{{- $opts := .Opts -}}

{{- if $services}}
//
// Server handler
//
{{range $_, $service := $services }}
{{- $serviceHasRoutes := false -}}
{{- range $_, $method := $service.Methods -}}
{{- if MethodHasRoute $method -}}
{{- $serviceHasRoutes = true -}}
{{- end -}}
{{- end }}
// serve{{$service.Name}}Rpc dispatches a web-standard Request to the {{$service.Name}} service
// and returns a web-standard Response, or null when the request path does not
// belong to this service (so the caller can try other routes).
export const serve{{$service.Name}}Rpc = async <Context>(service: {{$service.Name}}Server<Context>, ctx: Context, request: Request): Promise<Response | null> => {
  {{- if $serviceHasRoutes }}
  const rest = webrpcRestRoute({{firstLetterToLower $service.Name}}RestRoutes, request)
  if (rest instanceof Response) return rest
  if (rest) {
    try {
      const data = await webrpcRestData(rest.route, rest.pathParams, request)
      const response = await dispatch{{$service.Name}}Request(service, ctx, rest.route.name, request, data)
      return request.method === 'HEAD' ? webrpcHeadResponse(response) : response
    } catch (err) {
      return webrpcErrorResponse(err)
    }
  }
  {{- end }}
  const pathname = new URL(request.url).pathname
  if (!pathname.startsWith('{{$basepath}}{{$service.Name}}/')) return null
  const method = pathname.slice('{{$basepath}}{{$service.Name}}/'.length)
  if (method === '' || method.includes('/')) return null

  if (request.method !== 'POST') {
    return webrpcErrorResponse(new WebrpcBadMethodError({ cause: `unsupported HTTP method ${request.method} (only POST is allowed)` }), { Allow: 'POST' })
  }

  try {
    return await dispatch{{$service.Name}}Request(service, ctx, method, request)
  } catch (err) {
    return webrpcErrorResponse(err)
  }
}

{{- if $serviceHasRoutes }}

const {{firstLetterToLower $service.Name}}RestRoutes: WebrpcRestRoute[] = [
{{- range $_, $method := $service.Methods}}
{{- if MethodHasRoute $method}}
  { method: '{{MethodRouteVerb $method}}', path: '{{MethodRoutePath $method}}', rpcPath: '{{$basepath}}{{$service.Name}}/{{$method.Name}}', name: '{{$method.Name}}', params: [{{range $i, $p := MethodRouteParams $method}}{{if $i}}, {{end}}'{{$p.Name}}{{if $p.Optional}}?{{end}}: {{if $p.Repeated}}[]{{end}}{{$p.TypeExpr}}'{{end}}] },
{{- end}}
{{- end}}
]
{{- end }}

const dispatch{{$service.Name}}Request = async <Context>(service: {{$service.Name}}Server<Context>, ctx: Context, method: string, request: Request{{if $serviceHasRoutes}}, data?: { [key: string]: any }{{end}}): Promise<Response> => {
  switch (method) {
  {{- range $_, $method := $service.Methods}}
  {{- $methodReqName := "" -}}
  {{- if $method.Succinct -}}
    {{- $methodReqName = (index $method.Inputs 0).Type -}}
  {{- else -}}
    {{- if $opts.compat -}}
      {{- $methodReqName = printf "%sArgs" $method.Name -}}
    {{- else -}}
      {{- $methodReqName = printf "%sRequest" $method.Name -}}
    {{- end -}}
  {{- end}}
    case '{{$method.Name}}': {
      {{- if MethodHasFileUpload $method }}
      const form = await webrpcUploadFormData(request)
      const payload: any = webrpcParseRequestBody(form.get('json'), '{{$methodReqName}}')
      {{- range $_, $part := MethodFileParts $method }}
      {{- if or (eq $part.FieldName "") $method.Succinct }}
      webrpcFormFile{{if $part.Repeated}}s{{end}}(form, '{{$part.PartName}}', payload)
      {{- else }}
      if (payload['{{$part.ArgName}}'] || form.has('{{$part.PartName}}')) {
        payload['{{$part.ArgName}}'] = payload['{{$part.ArgName}}'] || {}
        webrpcFormFile{{if $part.Repeated}}s{{end}}(form, '{{$part.PartName}}', payload['{{$part.ArgName}}'])
      }
      {{- end }}
      {{- end }}
      {{- else }}
      const payload: any = {{if $serviceHasRoutes}}webrpcDecodeRequest(data ?? webrpcJsonBody(await webrpcRequestBodyText(request)), '{{$methodReqName}}'){{else}}webrpcParseRequestBody(await webrpcRequestBodyText(request), '{{$methodReqName}}'){{end}}
      {{- end }}
      {{- range $_, $input := $method.Inputs }}
      {{- if $method.Succinct }}
      if (payload && !validateType(payload, "{{template "jsType" dict "Type" $input.Type "TypeMap" $typeMap}}")) {
        throw new WebrpcBadRequestError({ cause: "invalid argument: {{ $input.Name }}" })
      }
      {{- else }}
      {{- if not $input.Optional}}
      if (!{{if $serviceHasRoutes}}Object.hasOwn(payload, "{{ $input.Name }}"){{else}}("{{ $input.Name }}" in payload){{end}}) {
        throw new WebrpcBadRequestError({ cause: "missing argument `{{ $input.Name }}`" })
      }
      {{- end }}
      if ({{if $serviceHasRoutes}}Object.hasOwn(payload, "{{ $input.Name }}"){{else}}"{{ $input.Name }}" in payload{{end}} && !validateType(payload["{{ $input.Name }}"], "{{template "jsType" dict "Type" $input.Type "TypeMap" $typeMap}}")) {
        throw new WebrpcBadRequestError({ cause: "invalid argument: {{ $input.Name }}" })
      }
      {{- end}}
      {{- end}}
      const result = await service.{{firstLetterToLower $method.Name}}(ctx, payload || {})
      {{- if MethodHasFileDownload $method }}
      return webrpcFileResponse(result)
      {{- else }}
      return webrpcJsonResponse(result ?? {})
      {{- end }}
    }
  {{end}}
    default:
      throw new WebrpcBadRouteError({ cause: 'method not found' })
  }
}

{{- end}}
{{"\n"}}
const webrpcRequestBodyText = async (request: Request): Promise<string> => {
  const contentType = (request.headers.get('Content-Type') || '').split(';')[0]!.trim().toLowerCase()
  if (contentType !== 'application/json') {
    throw new WebrpcBadRequestError({ cause: `unsupported Content-Type '${request.headers.get('Content-Type') || ''}' (only application/json is allowed)` })
  }
  return request.text()
}

const webrpcParseRequestBody = (body: unknown, typ: string): any => {
  if (typeof body !== 'string' || body === '') {
    return {}
  }
  let data: any
  try {
    data = JSON.parse(body)
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof Error ? err.message : String(err)}` })
  }
  try {
    return JsonDecode(data, typ) ?? {}
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof WebrpcError ? String(err.cause ?? err.message) : err instanceof Error ? err.message : String(err)}` })
  }
}

const webrpcJsonResponse = (data: any): Response => {
  return new Response(JsonEncode(data), {
    status: 200,
    headers: { [WebrpcHeader]: WebrpcHeaderValue, 'Content-Type': 'application/json' },
  })
}

const webrpcErrorResponse = (err: unknown, headers?: { [key: string]: string }): Response => {
  const rpcErr = err instanceof WebrpcError ? err : new WebrpcEndpointError({ cause: err instanceof Error ? err.message : String(err) })
  const body: { [key: string]: any } = { error: rpcErr.name, code: rpcErr.code, msg: rpcErr.message, status: rpcErr.status }
  if (rpcErr.cause !== undefined) {
    body['cause'] = String(rpcErr.cause)
  }
  return new Response(JSON.stringify(body), {
    status: rpcErr.status || 400,
    headers: { ...headers, [WebrpcHeader]: WebrpcHeaderValue, 'Content-Type': 'application/json' },
  })
}

{{- if $opts.restRoutes}}
{{"\n"}}
// WebrpcRestRoute serves a REST route as the webrpc method name. Params bind
// path and query params to request fields, in RIDL syntax: 'tags?: []string'.
type WebrpcRestRoute = { method: string, path: string, rpcPath: string, name: string, params: string[] }

type WebrpcRestMatch = { route: WebrpcRestRoute, pathParams: Map<string, string> }

// webrpcRestRoute matches the request against the routes. It returns the
// matched route, an error Response (wrong verb or a routed method's RPC path),
// or null when no route path matches (so the caller can try the RPC path).
const webrpcRestRoute = (routes: WebrpcRestRoute[], request: Request): WebrpcRestMatch | Response | null => {
  const url = new URL(request.url)
  // A routed method answers only on its route.
  if (routes.some((route) => route.rpcPath === url.pathname)) {
    return webrpcErrorResponse(new WebrpcBadRouteError({ cause: `no webrpc method defined for path ${url.pathname}` }))
  }
  const segments = url.pathname.slice(1).split('/')
  const verb = request.method === 'HEAD' ? 'GET' : request.method
  const allowed: string[] = []
  let match: (WebrpcRestMatch & { static: number }) | undefined
  for (const route of routes) {
    const pathParams = webrpcMatchRestPath(route.path, segments)
    if (!pathParams) continue
    allowed.push(route.method)
    // Static segments beat params, e.g. /items/search over /items/{id}.
    const staticCount = segments.length - pathParams.size
    if (route.method === verb && (!match || staticCount > match.static)) {
      match = { route, pathParams, static: staticCount }
    }
  }
  if (!match) {
    if (allowed.length === 0) return null
    // HEAD is served by every GET route, so it is allowed wherever GET is.
    const methods = [...new Set(allowed.flatMap((m) => (m === 'GET' ? ['GET', 'HEAD'] : [m])))]
    return webrpcErrorResponse(new WebrpcBadMethodError({ cause: `unsupported HTTP method ${request.method} (allowed: ${methods.join(', ')})` }), { Allow: methods.join(', ') })
  }
  return { route: match.route, pathParams: match.pathParams }
}

// webrpcRestData builds the webrpc request data of a REST route: the JSON body
// (body verbs only), then path params, then query params overwrite it.
const webrpcRestData = async (route: WebrpcRestRoute, pathParams: Map<string, string>, request: Request): Promise<{ [key: string]: any }> => {
  const url = new URL(request.url)
  const hasBody = route.method === 'POST' || route.method === 'PUT' || route.method === 'PATCH' || route.method === 'QUERY'
  const data: { [key: string]: any } = hasBody ? webrpcJsonBody(await webrpcRequestBodyText(request)) : {}
  for (const param of route.params) {
    const [, name, optional, repeated, type] = param.match(/^(\w+)(\??): (\[\])?(\w+)$/)!
    const kind = pathParams.has(name!) ? 'path' : 'query'
    const values = kind === 'path' ? [pathParams.get(name!)!] : url.searchParams.getAll(name!)
    if (values.length === 0) {
      if (repeated && !optional) data[name!] = []
      else if (!optional) throw new WebrpcBadRequestError({ cause: `missing ${kind} param '${name}'` })
      continue
    }
    const coerced = values.map((v) => {
      const value = webrpcRestParam(v, type!)
      if (value === undefined) throw new WebrpcBadRequestError({ cause: `invalid ${kind} param '${name}': "${v}" is not a valid ${type}` })
      return value
    })
    data[name!] = repeated ? coerced : coerced[0]
  }
  return data
}

// webrpcMatchRestPath returns the decoded path params if segments match the path template.
// Segments are compared after percent-decoding; empty segments never match.
const webrpcMatchRestPath = (path: string, segments: string[]): Map<string, string> | null => {
  const parts = path.slice(1).split('/')
  if (parts.length !== segments.length) return null
  const params = new Map<string, string>()
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i]!
    let value: string
    try {
      value = decodeURIComponent(segments[i]!)
    } catch {
      return null
    }
    if (!part.startsWith('{')) {
      if (value !== part) return null
      continue
    }
    if (value === '') return null
    params.set(part.slice(1, -1), value)
  }
  return params
}

// webrpcIntRanges bounds the sized integer params; 64-bit types use the safe integer range.
const webrpcIntRanges: { [type: string]: [number, number] } = {
  int8: [-128, 127],
  int16: [-32768, 32767],
  int32: [-2147483648, 2147483647],
  uint8: [0, 255],
  uint16: [0, 65535],
  uint32: [0, 4294967295],
}

// webrpcRestParam converts a path/query param string to the field's type, or undefined if invalid.
// Bools follow strconv.ParseBool and integers follow strconv.ParseInt/ParseUint, as in the Go server.
const webrpcRestParam = (value: string, type: string): any => {
  if (type === 'bool') {
    if (['1', 't', 'T', 'TRUE', 'true', 'True'].includes(value)) return true
    if (['0', 'f', 'F', 'FALSE', 'false', 'False'].includes(value)) return false
    return undefined
  }
  if (/^u?int/.test(type)) {
    if (!(type.startsWith('u') ? /^\d+$/ : /^[+-]?\d+$/).test(value)) return undefined
    const n = Number(value)
    const [min, max] = webrpcIntRanges[type] ?? [-Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER]
    return Number.isSafeInteger(n) && n >= min && n <= max ? n : undefined
  }
  if (type.startsWith('float')) {
    const n = Number(value)
    return value.trim() !== '' && Number.isFinite(n) ? n : undefined
  }
  return value
}

// webrpcJsonBody parses a JSON request body into the request data object.
const webrpcJsonBody = (body: string): { [key: string]: any } => {
  if (body === '') {
    return {}
  }
  let data: any
  try {
    data = JSON.parse(body)
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof Error ? err.message : String(err)}` })
  }
  // null is read as {}, like Go's encoding/json unmarshal into a struct.
  if (data === null) {
    return {}
  }
  if (typeof data !== 'object' || Array.isArray(data)) {
    throw new WebrpcBadRequestError({ cause: 'request data must be a JSON object' })
  }
  return data
}

// webrpcDecodeRequest decodes the request data into the method's input type.
const webrpcDecodeRequest = (data: { [key: string]: any }, typ: string): any => {
  try {
    return JsonDecode(data, typ) ?? {}
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof WebrpcError ? String(err.cause ?? err.message) : err instanceof Error ? err.message : String(err)}` })
  }
}

// webrpcHeadResponse answers HEAD like GET, without the body.
const webrpcHeadResponse = (response: Response): Response => new Response(null, { status: response.status, headers: response.headers })
{{- end}}

{{- if $opts.fileUpload}}
{{"\n"}}
const webrpcUploadFormData = async (request: Request): Promise<FormData> => {
  const contentType = (request.headers.get('Content-Type') || '').split(';')[0]!.trim().toLowerCase()
  if (contentType !== 'multipart/form-data') {
    throw new WebrpcBadRequestError({ cause: `unsupported Content-Type '${request.headers.get('Content-Type') || ''}' (only multipart/form-data is allowed)` })
  }
  try {
    return await request.formData()
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to parse multipart form: ${err instanceof Error ? err.message : String(err)}` })
  }
}

{{- if $opts.fileUploadSingle}}

// webrpcFormFile sets the named file argument from its multipart form part,
// or removes the argument when the part is absent.
const webrpcFormFile = (form: FormData, name: string, args: any) => {
  const file = form.get(name)
  if (file instanceof Blob) {
    args[name] = file
  } else {
    delete args[name]
  }
}
{{- end}}
{{- if $opts.fileUploadRepeated}}

// webrpcFormFiles sets the named repeated file argument from all multipart
// form parts of that name; no parts yield an empty array.
const webrpcFormFiles = (form: FormData, name: string, args: any) => {
  args[name] = form.getAll(name).filter((entry): entry is File => entry instanceof Blob)
}
{{- end}}
{{- end}}

{{- if $opts.fileDownload}}
{{"\n"}}
// webrpcFileResponse streams the file returned by a download method as the
// raw response body, with the file's metadata carried in the headers. The
// inline Content-Disposition lets browsers preview the file in place; its
// filename still names the file on save-as.
const webrpcFileResponse = (file: Blob | File): Response => {
  if (!(file instanceof Blob)) {
    return webrpcErrorResponse(new WebrpcBadResponseError({ cause: 'download method did not return a file' }))
  }
  const headers = new Headers({
    [WebrpcHeader]: WebrpcHeaderValue,
    'Content-Type': file.type || 'application/octet-stream',
    'Content-Length': String(file.size),
    'X-Content-Type-Options': 'nosniff',
  })
  if (file instanceof File && file.name !== '') {
    headers.set('Content-Disposition', webrpcContentDisposition(file.name))
  }
  return new Response(file, { status: 200, headers })
}

// webrpcContentDisposition formats the inline Content-Disposition header,
// escaping the filename per RFC 6266 / RFC 5987.
const webrpcContentDisposition = (filename: string): string => {
  if (/^[\x20-\x21\x23-\x5b\x5d-\x7e]*$/.test(filename)) {
    return `inline; filename="${filename}"`
  }
  if (/^[\x20-\x7e]*$/.test(filename)) {
    return `inline; filename="${filename.replace(/([\\"])/g, '\\$1')}"`
  }
  return `inline; filename*=utf-8''${encodeURIComponent(filename)}`
}
{{- end}}
{{end -}}
{{end}}
