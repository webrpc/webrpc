{{- define "server" -}}

{{- $basepath := .BasePath -}}
{{- $services := .Services -}}
{{- $typeMap := .TypeMap -}}
{{- $opts := .Opts -}}

{{- if $services}}
//
// Server handler
//
{{range $_, $service := $services }}
// serve{{$service.Name}}Rpc dispatches a web-standard Request to the {{$service.Name}} service
// and returns a web-standard Response, or null when the request path does not
// belong to this service (so the caller can try other routes).
export const serve{{$service.Name}}Rpc = async <Context>(service: {{$service.Name}}Server<Context>, ctx: Context, request: Request): Promise<Response | null> => {
  const pathname = new URL(request.url).pathname
  if (!pathname.startsWith('{{$basepath}}{{$service.Name}}/')) return null
  const method = pathname.slice('{{$basepath}}{{$service.Name}}/'.length)
  if (method === '' || method.includes('/')) return null

  if (request.method !== 'POST') {
    return webrpcErrorResponse(new WebrpcBadMethodError({ cause: `unsupported HTTP method ${request.method} (only POST is allowed)` }), { Allow: 'POST' })
  }

  try {
    return await dispatch{{$service.Name}}Request(service, ctx, method, request)
  } catch (err) {
    return webrpcErrorResponse(err)
  }
}

const dispatch{{$service.Name}}Request = async <Context>(service: {{$service.Name}}Server<Context>, ctx: Context, method: string, request: Request): Promise<Response> => {
  switch (method) {
  {{- range $_, $method := $service.Methods}}
  {{- $methodReqName := "" -}}
  {{- if $method.Succinct -}}
    {{- $methodReqName = (index $method.Inputs 0).Type -}}
  {{- else -}}
    {{- if $opts.compat -}}
      {{- $methodReqName = printf "%sArgs" $method.Name -}}
    {{- else -}}
      {{- $methodReqName = printf "%sRequest" $method.Name -}}
    {{- end -}}
  {{- end}}
    case '{{$method.Name}}': {
      {{- if MethodHasFileUpload $method }}
      const form = await webrpcUploadFormData(request)
      const payload: any = webrpcParseRequestBody(form.get('json'), '{{$methodReqName}}')
      {{- range $_, $part := MethodFileParts $method }}
      {{- if or (eq $part.FieldName "") $method.Succinct }}
      webrpcFormFile{{if $part.Repeated}}s{{end}}(form, '{{$part.PartName}}', payload)
      {{- else }}
      if (payload['{{$part.ArgName}}'] || form.has('{{$part.PartName}}')) {
        payload['{{$part.ArgName}}'] = payload['{{$part.ArgName}}'] || {}
        webrpcFormFile{{if $part.Repeated}}s{{end}}(form, '{{$part.PartName}}', payload['{{$part.ArgName}}'])
      }
      {{- end }}
      {{- end }}
      {{- else }}
      const payload: any = webrpcParseRequestBody(await webrpcRequestBodyText(request), '{{$methodReqName}}')
      {{- end }}
      {{- range $_, $input := $method.Inputs }}
      {{- if $method.Succinct }}
      if (payload && !validateType(payload, "{{template "jsType" dict "Type" $input.Type "TypeMap" $typeMap}}")) {
        throw new WebrpcBadRequestError({ cause: "invalid argument: {{ $input.Name }}" })
      }
      {{- else }}
      {{- if not $input.Optional}}
      if (!("{{ $input.Name }}" in payload)) {
        throw new WebrpcBadRequestError({ cause: "missing argument `{{ $input.Name }}`" })
      }
      {{- end }}
      if ("{{ $input.Name }}" in payload && !validateType(payload["{{ $input.Name }}"], "{{template "jsType" dict "Type" $input.Type "TypeMap" $typeMap}}")) {
        throw new WebrpcBadRequestError({ cause: "invalid argument: {{ $input.Name }}" })
      }
      {{- end}}
      {{- end}}
      const result = await service.{{firstLetterToLower $method.Name}}(ctx, payload || {})
      {{- if MethodHasFileDownload $method }}
      return webrpcFileResponse(result)
      {{- else }}
      return webrpcJsonResponse(result ?? {})
      {{- end }}
    }
  {{end}}
    default:
      throw new WebrpcBadRouteError({ cause: 'method not found' })
  }
}

{{- end}}
{{"\n"}}
const webrpcContentType = (request: Request): string => {
  return (request.headers.get('Content-Type') || '').split(';')[0]!.trim().toLowerCase()
}

const webrpcRequestBodyText = async (request: Request): Promise<string> => {
  if (webrpcContentType(request) !== 'application/json') {
    throw new WebrpcBadRequestError({ cause: `unsupported Content-Type '${request.headers.get('Content-Type') || ''}' (only application/json is allowed)` })
  }
  return request.text()
}

const webrpcParseRequestBody = (body: unknown, typ: string): any => {
  if (typeof body !== 'string' || body === '') {
    return {}
  }
  let data: any
  try {
    data = JSON.parse(body)
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof Error ? err.message : String(err)}` })
  }
  try {
    return JsonDecode(data, typ) ?? {}
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to unmarshal request data: ${err instanceof WebrpcError ? String(err.cause ?? err.message) : err instanceof Error ? err.message : String(err)}` })
  }
}

const webrpcJsonResponse = (data: any): Response => {
  return new Response(JsonEncode(data), {
    status: 200,
    headers: { [WebrpcHeader]: WebrpcHeaderValue, 'Content-Type': 'application/json' },
  })
}

const webrpcErrorResponse = (err: unknown, headers?: { [key: string]: string }): Response => {
  const rpcErr = err instanceof WebrpcError ? err : new WebrpcEndpointError({ cause: err instanceof Error ? err.message : String(err) })
  const body: { [key: string]: any } = { error: rpcErr.name, code: rpcErr.code, msg: rpcErr.message, status: rpcErr.status }
  if (rpcErr.cause !== undefined) {
    body['cause'] = String(rpcErr.cause)
  }
  return new Response(JSON.stringify(body), {
    status: rpcErr.status || 400,
    headers: { ...headers, [WebrpcHeader]: WebrpcHeaderValue, 'Content-Type': 'application/json' },
  })
}

{{- if $opts.fileUpload}}
{{"\n"}}
const webrpcUploadFormData = async (request: Request): Promise<FormData> => {
  if (webrpcContentType(request) !== 'multipart/form-data') {
    throw new WebrpcBadRequestError({ cause: `unsupported Content-Type '${request.headers.get('Content-Type') || ''}' (only multipart/form-data is allowed)` })
  }
  try {
    return await request.formData()
  } catch (err) {
    throw new WebrpcBadRequestError({ cause: `failed to parse multipart form: ${err instanceof Error ? err.message : String(err)}` })
  }
}

{{- if $opts.fileUploadSingle}}

// webrpcFormFile sets the named file argument from its multipart form part,
// or removes the argument when the part is absent.
const webrpcFormFile = (form: FormData, name: string, args: any) => {
  const file = form.get(name)
  if (file instanceof Blob) {
    args[name] = file
  } else {
    delete args[name]
  }
}
{{- end}}
{{- if $opts.fileUploadRepeated}}

// webrpcFormFiles sets the named repeated file argument from all multipart
// form parts of that name; no parts yield an empty array.
const webrpcFormFiles = (form: FormData, name: string, args: any) => {
  args[name] = form.getAll(name).filter((entry): entry is File => entry instanceof Blob)
}
{{- end}}
{{- end}}

{{- if $opts.fileDownload}}
{{"\n"}}
// webrpcFileResponse streams the file returned by a download method as the
// raw response body, with the file's metadata carried in the headers. The
// inline Content-Disposition lets browsers preview the file in place; its
// filename still names the file on save-as.
const webrpcFileResponse = (file: Blob | File): Response => {
  if (!(file instanceof Blob)) {
    return webrpcErrorResponse(new WebrpcBadResponseError({ cause: 'download method did not return a file' }))
  }
  const headers = new Headers({
    [WebrpcHeader]: WebrpcHeaderValue,
    'Content-Type': file.type || 'application/octet-stream',
    'Content-Length': String(file.size),
    'X-Content-Type-Options': 'nosniff',
  })
  if (file instanceof File && file.name !== '') {
    headers.set('Content-Disposition', webrpcContentDisposition(file.name))
  }
  return new Response(file, { status: 200, headers })
}

// webrpcContentDisposition formats the inline Content-Disposition header,
// escaping the filename per RFC 6266 / RFC 5987.
const webrpcContentDisposition = (filename: string): string => {
  if (/^[\x20-\x21\x23-\x5b\x5d-\x7e]*$/.test(filename)) {
    return `inline; filename="${filename}"`
  }
  if (/^[\x20-\x7e]*$/.test(filename)) {
    return `inline; filename="${filename.replace(/([\\"])/g, '\\$1')}"`
  }
  return `inline; filename*=utf-8''${encodeURIComponent(filename)}`
}
{{- end}}
{{end -}}
{{end}}
