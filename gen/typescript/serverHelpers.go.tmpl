{{ define "serverHelpers" }}
{{- $types := .Types -}}
{{- $opts := .Opts -}}
{{- $typeMap := .TypeMap }}

//
// Server type validators
//

const JS_TYPES = [
    "bigint",
    "boolean",
    "function",
    "number",
    "object",
    "string",
    "symbol",
    "undefined"
]

{{- "\n" -}}{{- range $_, $type := $types }}
{{- if isEnumType $type }}
const validate{{ $type.Name }} = ({{if gt (len $type.Fields) 0}}value{{else}}_value{{end}}: any): boolean => {
  return {{range $i, $field := $type.Fields}}{{if $i}} || {{end}}value === '{{if eq $type.Type.Expr "string"}}{{$field.Value}}{{else}}{{enumWireValue $field}}{{end}}'{{else}}false{{end}}
}
{{else}}
const validate{{ $type.Name }} = ({{if gt (len $type.Fields) 0}}value{{else}}_value{{end}}: any) => {
  {{- range $_, $field := $type.Fields }}
  {{- if $field.Optional }}
  if ("{{template "fieldName" dict "Field" $field }}" in value && !validateType(value["{{template "fieldName" dict "Field" $field }}"], "{{template "jsType" dict "Type" (coalesce $field.Type $type.Type) "TypeMap" $typeMap}}")) {
    return false
  }
  {{- else }}
  if (!("{{template "fieldName" dict "Field" $field }}" in value) || !validateType(value["{{template "fieldName" dict "Field" $field }}"], "{{template "jsType" dict "Type" (coalesce $field.Type $type.Type) "TypeMap" $typeMap}}")) {
    return false
  }
  {{- end }}
{{- end }}
  return true
}
{{end -}}
{{end -}}

{{- "\n" -}}
const TYPE_VALIDATORS: { [type: string]: (value: any) => boolean } = {
{{- range $_, $type := $types }}
  {{ $type.Name }}: validate{{ $type.Name }},
{{- end }}
}

const validateType = (value: any, type: string): boolean => {
{{- if $opts.fileUpload }}
  if (type === "file") {
    return value instanceof Blob;
  }
  if (type === "file[]") {
    return Array.isArray(value) && value.every((entry) => entry instanceof Blob);
  }
{{- end }}
  if (type === "any") {
    return true;
  }
  if (type.endsWith("[]")) {
    const elemType = type.slice(0, -2);
    return Array.isArray(value) && value.every((elem) => validateType(elem, elemType));
  }
  if (JS_TYPES.indexOf(type) > -1) {
    return typeof value === type;
  }
  const validator = TYPE_VALIDATORS[type];
  if (!validator) {
    return false;
  }
  return validator(value)
}

{{- end}}
