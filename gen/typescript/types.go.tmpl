{{- define "types" -}}

{{- $typeMap := .TypeMap -}}
{{- $types := .Types -}}
{{- $services := .Services -}}
{{- $opts := .Opts -}}

//
// Schema types
//
{{if $types -}}
{{range $_i, $type := $types -}}

{{if isEnumType $type }}
{{- if eq $opts.enumStyle "union"}}
export const {{$type.Name}} = {
{{- range $i, $field := $type.Fields}}
  {{- if eq $type.Type.Expr "string"}}
  {{$field.Name}}: '{{$field.Value}}',
  {{- else}}
  {{$field.Name}}: '{{$field.Name}}',
  {{- end}}
{{- end}}
} as const
export type {{$type.Name}} = (typeof {{$type.Name}})[keyof typeof {{$type.Name}}]
{{- else}}
export enum {{$type.Name}} {
{{- range $i, $field := $type.Fields}}
  {{- if $i}},{{end}}
  {{- if eq $type.Type.Expr "string"}}
  {{$field.Name}} = '{{$field.Value}}'
  {{- else}}
  {{$field.Name}} = '{{$field.Name}}'
  {{- end}}
{{- end}}
}
{{- end}}
{{end -}}

{{- if isAliasType $type }}
export type {{$type.Name}} = {{template "type" dict "Type" $type.Type "TypeMap" $typeMap}}
{{end -}}

{{- if isStructType $type }}
export interface {{$type.Name}} {
  {{- range $_, $field := $type.Fields}}
  {{- $isExportable := true -}}
  {{- range $meta := $field.Meta -}}
    {{- if exists $meta "json" -}}
      {{- if eq (printf "%v" (get $meta "json")) "-" -}}
        {{- $isExportable = false}}
      {{- end -}}
    {{- end -}}
  {{- end }}
  {{- if $isExportable }}
  {{template "fieldName" dict "Field" .}}{{if .Optional}}?{{end}}: {{template "type" dict "Type" $field.Type "TypeMap" $typeMap}}
  {{- end -}}
  {{- end}}
}
{{end -}}
{{- end -}}
{{- end -}}

{{/* Request/response generated types */}}
{{- if $services}}
{{- range $_, $service := $services}}
{{range $_, $method := $service.Methods}}
{{- if eq $method.Succinct false -}}
export interface {{$method.Name}}{{if $opts.compat}}Args{{else}}Request{{end}} {
{{- range $_, $input := $method.Inputs}}
  {{$input.Name}}{{if $input.Optional}}?{{end}}: {{template "type" dict "Type" $input.Type "TypeMap" $typeMap}}
{{- end}}
}
{{- if MethodHasFileDownloadMeta $method}}
{{- /* The response body carries the raw file, so the remaining outputs ride
     along in the Webrpc-Response header instead. The client receives the
     downloaded file as a WebrpcFile, which only client builds declare; the
     server returns a Blob or File. */}}
{{- if $opts.client}}

export interface {{$method.Name}}{{if $opts.compat}}Return{{else}}Response{{end}} {
{{- range $_, $output := $method.Outputs}}
  {{$output.Name}}{{if $output.Optional}}?{{end}}: {{if eq (printf "%v" $output.Type) "file"}}WebrpcFile{{else}}{{template "type" dict "Type" $output.Type "TypeMap" $typeMap}}{{end}}
{{- end}}
}
{{- end}}
{{- if $opts.server}}

export interface {{$method.Name}}File{{if $opts.compat}}Return{{else}}Response{{end}} {
{{- range $_, $output := $method.Outputs}}
  {{$output.Name}}{{if $output.Optional}}?{{end}}: {{template "type" dict "Type" $output.Type "TypeMap" $typeMap}}
{{- end}}
}
{{- end}}
{{- else if not (MethodHasFileDownload $method)}}

export interface {{$method.Name}}{{if $opts.compat}}Return{{else}}Response{{end}} {
{{- range $_, $output := $method.Outputs}}
  {{$output.Name}}{{if $output.Optional}}?{{end}}: {{template "type" dict "Type" $output.Type "TypeMap" $typeMap}}
{{- end}}
}
{{- end}}
{{end}}
{{end -}}

{{- end -}}
{{- end -}}
{{- end -}}
