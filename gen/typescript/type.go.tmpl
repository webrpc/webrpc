{{- define "type" -}}

{{- $type := .Type -}}
{{- $typeMap := .TypeMap -}}

{{- if isMapType $type -}}

    {{- /* An index signature key must be string or number; enum (and other
           named) key types need a mapped type instead. */ -}}
    {{- if isCoreType (mapKeyType $type) -}}
    {[key: {{template "type" dict "Type" (mapKeyType $type) "TypeMap" $typeMap}}]: {{template "type" dict "Type" (mapValueType $type) "TypeMap" $typeMap}}}
    {{- else -}}
    {[key in {{template "type" dict "Type" (mapKeyType $type) "TypeMap" $typeMap}}]?: {{template "type" dict "Type" (mapValueType $type) "TypeMap" $typeMap}}}
    {{- end -}}

{{- else if isListType $type -}}

    {{- /* A list of bytes is base64-encoded into a single string, not an
           array of anything. Go, Kotlin and Dart all serialize it that way. */ -}}
    {{- if eq (printf "%v" (listElemType $type)) "byte" -}}
    string
    {{- else -}}
    Array<{{template "type" dict "Type" (listElemType $type) "TypeMap" $typeMap}}>
    {{- end -}}


{{- else if isCoreType $type -}}

    {{get $typeMap $type}}

{{- else -}}

    {{$type}}

{{- end -}}
{{- end -}}