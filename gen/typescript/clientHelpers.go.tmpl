{{- define "clientHelpers" -}}
{{- $webrpcErrors := .WebrpcErrors -}}
{{- $schemaErrors := .SchemaErrors -}}
{{- $opts := .Opts -}}

{{- "\n" -}}
const createHttpRequest = (body: string = '{}', headers: object = {}, signal: AbortSignal | null = null): object => {
  const reqHeaders: { [key: string]: string } = { ...headers, 'Content-Type': 'application/json' {{- if eq $opts.webrpcHeader true }}, [WebrpcHeader]: WebrpcHeaderValue{{ end }} }
  return { method: 'POST', headers: reqHeaders, body, signal }
}

{{- if $opts.restRoutes }}

// Checks the raw value: decoding would wrongly reject an encoded "%2e%2e", which is sent safely.
const isDotPathSegment = (segment: string): boolean => segment === '' || segment === '.' || segment === '..'

// Path fields fill the template; the rest go to the query string, or to the JSON body for body verbs.
const createHttpRestRequest = (hostname: string, method: string, path: string, hasBody: boolean, req: object, headers: object = {}, signal: AbortSignal | null = null): [string, object] => {
  const fields: { [key: string]: any } = JSON.parse(JsonEncode(req))
  const query = new URLSearchParams()
  // One replace pass over the template, so a substituted value is never re-expanded.
  path = path.replace(/\{(\w+)\}/g, (_, name) => {
    const value = String(fields[name])
    delete fields[name]
    // A dot segment is normalized away by URL parsers, and encoding cannot fix it.
    if (isDotPathSegment(value)) {
      throw WebrpcBadRequestError.new({ cause: `invalid path param '${name}': "${value}" is not a valid path segment` })
    }
    return encodeURIComponent(value)
  })
  if (!hasBody) {
    for (const [name, value] of Object.entries(fields)) {
      for (const v of Array.isArray(value) ? value : value == null ? [] : [value]) {
        query.append(name, String(v))
      }
    }
  }
  const qs = query.toString()
  const reqHeaders: { [key: string]: string } = { ...headers {{- if eq $opts.webrpcHeader true }}, [WebrpcHeader]: WebrpcHeaderValue{{ end }} }
  if (hasBody) {
    reqHeaders['Content-Type'] = 'application/json'
  }
  return [hostname + path + (qs ? '?' + qs : ''), { method, headers: reqHeaders, body: hasBody ? JsonEncode(req) : undefined, signal }]
}
{{- end }}

const buildResponse = (res: Response): Promise<any> => {
  return res.text().then(text => {
    let data
    try {
      data = JSON.parse(text)
    } catch(error) {
      throw WebrpcBadResponseError.new({
        status: res.status,
        cause: `JSON.parse(): ${error instanceof Error ? error.message : String(error)}: response text: ${text}`},
      )
    }
    if (!res.ok) {
      const code: number = (typeof data.code === 'number') ? data.code : 0
      throw (webrpcErrorByCode[code] || WebrpcError).new(data)
    }
    return data
  })
}

export type Fetch = (input: RequestInfo, init?: RequestInit) => Promise<Response>

{{if $opts.streaming}}
export interface WebrpcStreamOptions<T> extends WebrpcOptions {
  onMessage: (message: T) => void;
  onError: (error: WebrpcError, reconnect: () => void) => void;
  onOpen?: () => void;
  onClose?: () => void;
}

export interface WebrpcOptions {
  headers?: HeadersInit;
  signal?: AbortSignal;
}

export interface WebrpcStreamController {
  abort: (reason?: any) => void;
  closed: Promise<void>;
}
{{end}}
{{end}}
