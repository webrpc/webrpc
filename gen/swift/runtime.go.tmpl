}

{{$access}} protocol WebRPCTransport: Sendable {
    func post(
        baseURL: String,
        path: String,
        body: Data,
        headers: [String: String]
    ) async throws -> WebRPCHTTPResponse
{{- if $opts.fileUpload }}

    // postMultipart makes a multipart/form-data request: a "json" part
    // carrying `body` (the JSON-encoded non-file arguments) is sent first,
    // followed by one part per file.
    func postMultipart(
        baseURL: String,
        path: String,
        body: Data,
        files: [WebRPCFilePart],
        headers: [String: String]
    ) async throws -> WebRPCHTTPResponse
{{- end }}
{{- if $opts.fileDownload }}

    // postRaw makes a JSON request like post, but the successful response
    // body is the raw (binary) file content rather than a JSON envelope.
    func postRaw(
        baseURL: String,
        path: String,
        body: Data,
        headers: [String: String]
    ) async throws -> WebRPCHTTPResponse
{{- end }}
}

{{$access}} struct WebRPCTransportError: Error, Sendable {
