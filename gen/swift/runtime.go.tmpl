    {{$access}} let statusCode: Int
    {{$access}} let body: Data
    {{$access}} let headers: [String: String]

    {{$access}} init(
        statusCode: Int,
        body: Data,
        headers: [String: String] = [:]
    ) {
        self.statusCode = statusCode
        self.body = body
        self.headers = headers
