{{- define "main" -}}

{{- $opts := dict -}}
{{- set $opts "client" (ternary (in .Opts.client "" "true") true false) -}}
{{- set $opts "webrpcHeader" (ternary (eq (default .Opts.webrpcHeader "true") "false") false true) -}}
{{- set $opts "schemaHash" (ternary (eq (default .Opts.schemaHash "true") "false") false true) -}}
{{- set $opts "visibility" (default .Opts.visibility "public") -}}
{{- set $opts "namespace" (default .Opts.namespace "") -}}
{{- $namespace := get $opts "namespace" -}}

{{- if exists .Opts "help" -}}
  {{- template "help" $opts -}}
  {{- exit 0 -}}
{{- end -}}

{{- if not (in (get $opts "visibility") "public" "internal") -}}
  {{- stderrPrintf "%s generator error: visibility must be public or internal\n" .WebrpcTarget -}}
  {{- exit 1 -}}
{{- end -}}

{{- if and (ne $namespace "") (not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $namespace)) -}}
  {{- stderrPrintf "%s generator error: namespace must use ASCII identifier syntax\n" .WebrpcTarget -}}
  {{- exit 1 -}}
{{- end -}}

{{- range $k, $v := .Opts -}}
  {{- if not (exists $opts $k) -}}
    {{- stderrPrintf "-%v=%q is not supported target option\n\nUsage:\n" $k $v -}}
    {{- template "help" $opts -}}
    {{- exit 1 -}}
  {{- end -}}
{{- end -}}

{{- if ne .WebrpcVersion "v1" -}}
  {{- stderrPrintf "%s generator error: unsupported webrpc version %s\n" .WebrpcTarget .WebrpcVersion -}}
  {{- exit 1 -}}
{{- end -}}

{{- if not (minVersion .WebrpcGenVersion "v0.14.0") -}}
  {{- stderrPrintf "%s generator error: unsupported webrpc-gen version %s, please update\n" .WebrpcTarget .WebrpcGenVersion -}}
  {{- exit 1 -}}
{{- end -}}

{{- /* Streaming is not supported; fail loudly rather than emit broken unary code. */ -}}
{{- range $_, $service := .Services -}}
  {{- range $_, $method := $service.Methods -}}
    {{- if or $method.StreamInput $method.StreamOutput -}}
      {{- stderrPrintf "%s generator error: streaming methods are not supported (%s.%s)\n" $.WebrpcTarget $service.Name $method.Name -}}
      {{- exit 1 -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Detect file upload/download methods and file-carrying struct types. */ -}}
{{- range $_, $service := .Services -}}
  {{- range $_, $method := $service.Methods -}}
    {{- if MethodHasFileUpload $method -}}
      {{- set $opts "fileUpload" true -}}
      {{- set $opts "fileType" true -}}
    {{- end -}}
    {{- if MethodHasFileDownloadMeta $method -}}
    {{- stderrPrintf "%s generator error: %s.%s returns metadata outputs alongside its file, which the %s target does not support yet; the metadata travels in the Webrpc-Response header and only the golang and typescript targets decode it. Declare the file as the method's only output, or return the metadata from a separate method\n" $.WebrpcTarget $service.Name $method.Name $.WebrpcTarget -}}
    {{- exit 1 -}}
    {{- end -}}
    {{- if MethodHasFileDownload $method -}}
      {{- set $opts "fileDownload" true -}}
      {{- set $opts "fileType" true -}}
    {{- end -}}
    {{- if and (MethodHasFileUpload $method) (MethodHasFileDownload $method) -}}
      {{- set $opts "fileUploadDownload" true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $_, $type := .Types -}}
  {{- if isStructType $type -}}
    {{- range $_, $field := $type.Fields -}}
      {{- if or (eq (printf "%v" $field.Type) "file") (eq (printf "%v" $field.Type) "[]file") -}}
        {{- set $opts "fileType" true -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $typeMap := dict -}}
{{- set $typeMap "null" "WebRPCNull" -}}
{{- set $typeMap "any" "WebRPCJSONValue" -}}
{{- set $typeMap "byte" "UInt8" -}}
{{- set $typeMap "bool" "Bool" -}}
{{- set $typeMap "uint" "UInt32" -}}
{{- set $typeMap "uint8" "UInt8" -}}
{{- set $typeMap "uint16" "UInt16" -}}
{{- set $typeMap "uint32" "UInt32" -}}
{{- set $typeMap "uint64" "UInt64" -}}
{{- set $typeMap "bigint" "String" -}}
{{- set $typeMap "int" "Int32" -}}
{{- set $typeMap "int8" "Int8" -}}
{{- set $typeMap "int16" "Int16" -}}
{{- set $typeMap "int32" "Int32" -}}
{{- set $typeMap "int64" "Int64" -}}
{{- set $typeMap "float32" "Float" -}}
{{- set $typeMap "float64" "Double" -}}
{{- set $typeMap "string" "String" -}}
{{- set $typeMap "timestamp" "String" -}}
{{- set $typeMap "file" "WebRPCFile" -}}

{{template "imports" dict "Opts" $opts}}
// {{.SchemaName}} {{.SchemaVersion}}{{if $opts.schemaHash}} {{.SchemaHash}}{{end}}
//
// Code generated by webrpc-gen@{{.WebrpcGenVersion}} with {{.WebrpcTarget}} generator. DO NOT EDIT.
//
// {{.WebrpcGenCommand}}

{{- $access := get $opts "visibility" -}}
{{- $static := ternary (ne (get $opts "namespace") "") "static " "" -}}
{{- if ne (get $opts "namespace") ""}}
{{$access}} enum {{get $opts "namespace"}} {
{{- end}}

{{- if $opts.schemaHash }}
{{$access}} {{$static}}let WEBRPC_VERSION = "{{.WebrpcVersion}}"
{{$access}} {{$static}}let WEBRPC_SCHEMA_VERSION = "{{.SchemaVersion}}"
{{$access}} {{$static}}let WEBRPC_SCHEMA_HASH = "{{.SchemaHash}}"
{{- end }}

{{template "runtime" dict "WebrpcErrors" .WebrpcErrors "SchemaErrors" .Errors "WebrpcHeader" .WebrpcHeader "Opts" $opts}}
{{- if $opts.fileType}}
{{template "fileHelpers" dict "Opts" $opts}}
{{- end}}

{{template "types" dict "Types" .Types "TypeMap" $typeMap "WebrpcTarget" .WebrpcTarget "Opts" $opts}}

{{if $opts.client}}
{{template "client" dict "BasePath" .BasePath "SchemaName" .SchemaName "Types" .Types "Services" .Services "TypeMap" $typeMap "WebrpcTarget" .WebrpcTarget "Opts" $opts}}
{{end}}

{{- if ne (get $opts "namespace") ""}}
}
{{- end}}

{{- end -}}
