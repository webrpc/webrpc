{{- define "field" -}}

{{- $type := .Type -}}
{{- $name := (coalesce .Name "") -}}
{{- $fieldName := $name | firstLetterToUpper -}}
{{- $keywordMap := .KeywordMap -}}
{{- $typePrefix := .TypePrefix -}}
{{- $typeMeta := .TypeMeta -}}
{{- $typeMap := .TypeMap -}}
{{- $optional := .Optional -}}
{{- $printName := .PrintName -}}
{{- $includeJsonTags := .JsonTags -}}
{{- $includeStructTags := .StructTags -}}
{{- $succinct := or .Succinct false -}}

{{- $customType := "" -}}
{{- $pointer := false -}}
{{- $jsonName := $name -}}
{{- $jsonOverride := false -}}
{{- $structTags := array -}}
{{- range $meta := $typeMeta -}}
    {{- if exists $meta "json" -}}
        {{- $jsonName = get $meta "json" -}}
    {{- end -}}
    {{- if exists $meta "go.field.name" -}}
        {{- $fieldName = get $meta "go.field.name" -}}
    {{- end -}}
    {{- if exists $meta "go.field.type" -}}
        {{- $customType = get $meta "go.field.type" -}}
    {{- end -}}
    {{- if exists $meta "go.tag.json" -}}
        {{- $jsonName = get $meta "go.tag.json" -}}
        {{- $jsonOverride = true -}}
    {{- end -}}
    {{- range $metaKey, $metaValue := $meta -}}
        {{- if and (hasPrefix $metaKey "go.tag.") (ne $metaKey "go.tag.json") -}}
            {{- $structTags = append $structTags (printf "%s:%q" (trimPrefix $metaKey "go.tag.") $metaValue) -}}
        {{- end -}}
    {{- end -}}
{{- end }}

{{- if $printName}}{{"\t"}}{{$fieldName}} {{end -}}
{{- if (ne $customType "") -}}
    {{- $pointer = hasPrefix (trim $customType) "*" -}}
    {{$customType}}

{{- else if isMapType $type -}}

    map[{{mapKeyType $type}}]{{template "field" dict "Name" $name "Type" (mapValueType $type) "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $typeMeta}}

{{- else if isListType $type -}}

    []{{template "field" dict "Name" $name "Type" (listElemType $type) "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $typeMeta}}

{{- else if isCoreType $type -}}
    {{- if eq (toString $type) "file" -}}
        {{- /* file is already a pointer type, no extra indirection when optional;
               the type itself may live in another package (-importTypesFrom) */ -}}
        {{- $pointer = true -}}
        *{{$typePrefix}}{{trimPrefix (get $typeMap $type) "*"}}
    {{- else -}}
        {{- $pointer = and $optional (ne (toString $type) "any") -}}
        {{if $pointer}}*{{end}}{{ get $typeMap $type }}
    {{- end -}}

{{- else -}}{{- /* structs, enums, aliases */ -}}
    {{- if or (isEnumType $type) (isAliasType $type) -}}
        {{- $pointer = $optional -}}
        {{if $pointer}}*{{end}}{{$typePrefix}}{{$type}}
    {{- else -}}
        {{- if $succinct -}}
            {{$typePrefix}}{{$type}}
        {{- else -}}
            {{- $pointer = true -}}
            *{{$typePrefix}}{{$type}}
        {{- end -}}
    {{- end -}}
{{- end -}}

{{- /* omitempty checks pointer presence without calling IsZero; omitzero preserves non-nil empty collections. */ -}}
{{- if $includeJsonTags -}}
{{- if and $optional (not $jsonOverride) (ne $jsonName "-") -}}
    {{- $omit := "omitzero" -}}
    {{- if $pointer -}}{{- $omit = "omitempty" -}}{{- end -}}
    {{- $jsonName = printf "%s,%s" $jsonName $omit -}}
{{- end -}}
{{- $jsonTag := printf "json:%q" $jsonName -}}
{{" "}}`{{$jsonTag}}{{if and $includeStructTags (len $structTags)}} {{join (sort $structTags) " "}}{{end}}`
{{- end -}}

{{- end -}}