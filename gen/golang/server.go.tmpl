{{- define "server"}}
{{- $services := .Services -}}
{{- $basepath := .BasePath -}}
{{- $keywordMap := .KeywordMap -}}
{{- $typeMap := .TypeMap -}}
{{- $typePrefix := .TypePrefix -}}
{{- $json := .Json -}}
{{- $opts := .Opts -}}

{{- $hasSuccinct := false -}}
{{- range $_, $service := $services -}}
{{- range $_, $method := $service.Methods -}}
{{- if and $method.Succinct (not $method.StreamOutput) -}}
{{- $hasSuccinct = true -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- if $services -}}
//
// Server
//

type WebRPCServer interface {
	http.Handler
}

type Options struct {
	OnError func(r *http.Request, rpcErr *WebRPCError)
	OnRequest func(w http.ResponseWriter, r *http.Request) error
{{- if $opts.fileUpload }}
	// MaxUploadSize caps multipart/form-data request bodies of file upload
	// methods. Defaults to DefaultMaxUploadSize when zero.
	MaxUploadSize int64
{{- end }}
}

{{/* Service servers */}}


{{- range $_, $service := $services}}
{{- $name := $service.Name -}}
{{- $serviceHasUpload := false -}}
{{- range $_, $method := $service.Methods -}}
{{- if MethodHasFileUpload $method -}}
{{- $serviceHasUpload = true -}}
{{- end -}}
{{- end -}}
{{ $serviceName := (printf "%sService" (firstWordToLower $service.Name)) }}

type {{$serviceName}} struct {
	{{$typePrefix}}{{$service.Name}}Server
	OnError func(r *http.Request, rpcErr *WebRPCError)
	OnRequest func(w http.ResponseWriter, r *http.Request) error
{{- if $serviceHasUpload }}
	MaxUploadSize int64
{{- end }}
}

func New{{firstLetterToUpper $service.Name}}Server(svc {{$typePrefix}}{{.Name}}Server, options ...*Options) *{{$serviceName}} {
	server := &{{$serviceName}}{
		{{.Name}}Server: svc,
	}
	if len(options) > 0 && options[0] != nil {
		server.OnError = options[0].OnError
		server.OnRequest = options[0].OnRequest
{{- if $serviceHasUpload }}
		server.MaxUploadSize = options[0].MaxUploadSize
{{- end }}
	}
	return server
}

func (s *{{$serviceName}}) Methods() []Method { return methodsFor(Service{{$service.Name}}, s) }

func (s *{{$serviceName}}) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	defer func() {
		// In case of a panic, serve a HTTP 500 error and then panic.
		if rr := recover(); rr != nil {
			s.sendErrorJSON(w, r, ErrWebrpcServerPanic.WithCausef("%v", rr))
			panic(rr)
		}
	}()

	w.Header().Set(WebrpcHeader, WebrpcHeaderValue)

	ctx := r.Context()
	ctx = context.WithValue(ctx, HTTPResponseWriterCtxKey, w)
	ctx = context.WithValue(ctx, HTTPRequestCtxKey, r)
	ctx = context.WithValue(ctx, ServiceNameCtxKey, "{{.Name}}")

	r = r.WithContext(ctx)

	var handler func(ctx context.Context, w http.ResponseWriter, r *http.Request)
{{- if $serviceHasUpload }}
	expectedContentType := "application/json"
{{- end }}
	switch r.URL.Path {
	{{- range $_, $method := $service.Methods}}
	case "{{$basepath}}{{$name}}/{{$method.Name}}":
		{{- if MethodHasFileUpload $method }}
		handler = s.serve{{$method.Name | firstLetterToUpper}}Multipart
		expectedContentType = "multipart/form-data"
		{{- else if and $method.Succinct (not $method.StreamOutput) }}
		handler = succinctHandler("{{$method.Name}}", s.{{$name}}Server.{{$method.Name}}, s.sendErrorJSON)
		{{- else }}
		handler = s.serve{{$method.Name | firstLetterToUpper}}JSON{{if $method.StreamOutput}}Stream{{end}}
		{{- end }}
	{{- end}}
	default:
		err := ErrWebrpcBadRoute.WithCausef("no webrpc method defined for path %v", r.URL.Path)
		s.sendErrorJSON(w, r, err)
		return
	}

	if r.Method != "POST" {
		w.Header().Add("Allow", "POST") // RFC 9110.
		err := ErrWebrpcBadMethod.WithCausef("unsupported HTTP method %v (only POST is allowed)", r.Method)
		s.sendErrorJSON(w, r, err)
		return
	}

	contentType := r.Header.Get("Content-Type")
	if i := strings.Index(contentType, ";"); i >= 0 {
		contentType = contentType[:i]
	}
	contentType = strings.TrimSpace(strings.ToLower(contentType))

	switch contentType {
{{- if $serviceHasUpload }}
	case expectedContentType:
{{- else }}
	case "application/json":
{{- end }}
		if s.OnRequest != nil {
			if err := s.OnRequest(w, r); err != nil {
				rpcErr, ok := err.(WebRPCError)
				if !ok {
					rpcErr = ErrWebrpcEndpoint.WithCause(err)
				}
				s.sendErrorJSON(w, r, rpcErr)
				return
			}
		}

		handler(ctx, w, r)
	default:
{{- if $serviceHasUpload }}
		err := ErrWebrpcBadRequest.WithCausef("unsupported Content-Type %q (only %s is allowed)", r.Header.Get("Content-Type"), expectedContentType)
{{- else }}
		err := ErrWebrpcBadRequest.WithCausef("unsupported Content-Type %q (only application/json is allowed)", r.Header.Get("Content-Type"))
{{- end }}
		s.sendErrorJSON(w, r, err)
	}
}
{{- range $_, $method := $service.Methods}}
{{- if eq $method.StreamOutput false }}
{{- if MethodHasFileUpload $method }}

func (s *{{$serviceName}}) serve{{firstLetterToUpper $method.Name}}Multipart(ctx context.Context, w http.ResponseWriter, r *http.Request) {
	ctx = context.WithValue(ctx, MethodNameCtxKey, "{{$method.Name}}")

	maxUploadSize := s.MaxUploadSize
	if maxUploadSize <= 0 {
		maxUploadSize = DefaultMaxUploadSize
	}
	r.Body = http.MaxBytesReader(w, r.Body, maxUploadSize)

	// Spool the parts (to memory, then to temporary files) so that every file
	// is readable by the time the method implementation is called.
	if err := r.ParseMultipartForm(multipartSpoolMemory); err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to parse multipart form: %w", err))
		return
	}
	defer r.MultipartForm.RemoveAll()

	{{ if $method.Succinct -}}
	{{- $input := index $method.Inputs 0 -}}
	reqPayload := {{$typePrefix}}{{$input.Type}}{}
	{{- else -}}
	reqPayload := struct {
	{{- range $i, $input := $method.Inputs}}
		Arg{{$i}} {{template "field" dict "Name" $input.Name "Type" $input.Type "Optional" $input.Optional "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $input.Meta "JsonTags" true}}
	{{- end}}
	}{}
	{{- end }}

	// The "json" part carries the non-file arguments; it may be absent when
	// the method has none.
	if jsonValue := r.MultipartForm.Value["json"]; len(jsonValue) > 0 {
		if err := {{$json}}.Unmarshal([]byte(jsonValue[0]), &reqPayload); err != nil {
			s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to unmarshal request data: %w", err))
			return
		}
	}

	var formErr error
	{{- range $_, $part := MethodFileParts $method }}
	{{- if $method.Succinct }}
	reqPayload.{{$part.FieldName}}, formErr = {{if $part.Repeated}}formFiles{{else}}formFile{{end}}(r.MultipartForm, "{{$part.PartName}}")
	{{- else if eq $part.FieldName "" }}
	reqPayload.Arg{{$part.ArgIndex}}, formErr = {{if $part.Repeated}}formFiles{{else}}formFile{{end}}(r.MultipartForm, "{{$part.PartName}}")
	{{- else }}
	if reqPayload.Arg{{$part.ArgIndex}} == nil {
		reqPayload.Arg{{$part.ArgIndex}} = &{{$typePrefix}}{{$part.StructName}}{}
	}
	reqPayload.Arg{{$part.ArgIndex}}.{{$part.FieldName}}, formErr = {{if $part.Repeated}}formFiles{{else}}formFile{{end}}(r.MultipartForm, "{{$part.PartName}}")
	{{- end }}
	if formErr != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCause(formErr))
		return
	}
	{{- end }}

	// Call service method implementation.
	{{range $i, $output := $method.Outputs}}ret{{$i}}, {{end}}err := s.{{$name}}Server.{{$method.Name}}(ctx{{range $i, $_ := $method.Inputs}}, {{if $method.Succinct}}reqPayload{{else}}reqPayload.Arg{{$i}}{{end}}{{end}})
	if err != nil {
		rpcErr, ok := err.(WebRPCError)
		if !ok {
			rpcErr = ErrWebrpcEndpoint.WithCause(err)
		}
		s.sendErrorJSON(w, r, rpcErr)
		return
	}

	{{- if MethodHasFileDownload $method }}

	if ret0 == nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadResponse.WithCausef("method {{$method.Name}} returned a nil file"))
		return
	}
	serveFileResponse(w, ret0)
	{{- else if $method.Succinct }}

	{{ if $opts.fixEmptyArrays -}}
	respBody, err := {{$json}}.Marshal(initializeNilSlices(ret0))
	{{ else -}}
	respBody, err := {{$json}}.Marshal(ret0)
	{{ end -}}
	if err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadResponse.WithCausef("failed to marshal json response: %w", err))
		return
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusOK)
	w.Write(respBody)
	{{- else }}

	{{- if gt (len $method.Outputs) 0}}

	respPayload := struct {
	{{- range $i, $output := $method.Outputs}}
		Ret{{$i}} {{template "field" dict "Name" $output.Name "Type" $output.Type "Optional" $output.Optional "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $output.Meta "JsonTags" true}}
	{{- end }}
	}{ {{- range $i, $_ := $method.Outputs}}{{if gt $i 0}}, {{end}}ret{{$i}}{{end}}}
	{{- end }}

	{{- if $method.Outputs | len}}
	{{ if $opts.fixEmptyArrays -}}
	respBody, err := {{$json}}.Marshal(initializeNilSlices(respPayload))
	{{ else -}}
	respBody, err := {{$json}}.Marshal(respPayload)
	{{ end -}}
	if err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadResponse.WithCausef("failed to marshal json response: %w", err))
		return
	}
	{{- end}}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusOK)

	{{- if $method.Outputs | len}}
	w.Write(respBody)
	{{- else }}
	w.Write([]byte("{}"))
	{{- end}}
	{{- end}}
}
{{- else if not $method.Succinct }}

func (s *{{$serviceName}}) serve{{firstLetterToUpper $method.Name}}JSON(ctx context.Context, w http.ResponseWriter, r *http.Request) {
	ctx = context.WithValue(ctx, MethodNameCtxKey, "{{$method.Name}}")

	{{ if gt (len $method.Inputs) 0 -}}
	reqBody, err := io.ReadAll(r.Body)
	if err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to read request data: %w", err))
		return
	}
	defer r.Body.Close()

	reqPayload := struct {
	{{- range $i, $input := $method.Inputs}}
		Arg{{$i}} {{template "field" dict "Name" $input.Name "Type" $input.Type "Optional" $input.Optional "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $input.Meta "JsonTags" true}}
	{{- end}}
	}{}
	if err := {{$json}}.Unmarshal(reqBody, &reqPayload); err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to unmarshal request data: %w", err))
		return
	}
	{{- end }}

	// Call service method implementation.
	{{range $i, $output := $method.Outputs}}ret{{$i}}, {{end}}err {{if or (eq (len $method.Inputs) 0) (gt (len $method.Outputs) 0)}}:{{end}}= s.{{$name}}Server.{{$method.Name}}(ctx{{range $i, $_ := $method.Inputs}}, reqPayload.Arg{{$i}}{{end}})
	if err != nil {
		rpcErr, ok := err.(WebRPCError)
		if !ok {
			rpcErr = ErrWebrpcEndpoint.WithCause(err)
		}
		s.sendErrorJSON(w, r, rpcErr)
		return
	}

	{{- if MethodHasFileDownload $method }}

	if ret0 == nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadResponse.WithCausef("method {{$method.Name}} returned a nil file"))
		return
	}
	serveFileResponse(w, ret0)
	{{- else }}

	{{- if gt (len $method.Outputs) 0}}

	respPayload := struct {
	{{- range $i, $output := $method.Outputs}}
		Ret{{$i}} {{template "field" dict "Name" $output.Name "Type" $output.Type "Optional" $output.Optional "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $output.Meta "JsonTags" true}}
	{{- end }}
	}{ {{- range $i, $_ := $method.Outputs}}{{if gt $i 0}}, {{end}}ret{{$i}}{{end}}}
	{{- end }}

	{{- if $method.Outputs | len}}
	{{ if $opts.fixEmptyArrays -}}
	respBody, err := {{$json}}.Marshal(initializeNilSlices(respPayload))
	{{ else -}}
	respBody, err := {{$json}}.Marshal(respPayload)
	{{ end -}}
	if err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadResponse.WithCausef("failed to marshal json response: %w", err))
		return
	}
	{{- end}}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusOK)

	{{- if $method.Outputs | len}}
	w.Write(respBody)
	{{- else }}
	w.Write([]byte("{}"))
	{{- end}}
	{{- end}}{{/* if MethodHasFileDownload */}}
}
{{- end}}{{/* if MethodHasFileUpload / not Succinct */}}
{{- else }}{{/* StreamOutput = true */}}

func (s *{{$serviceName}}) serve{{firstLetterToUpper $method.Name}}JSONStream(ctx context.Context, w http.ResponseWriter, r *http.Request) {
	ctx = context.WithValue(ctx, MethodNameCtxKey, "{{$method.Name}}")

	{{ if gt (len $method.Inputs) 0 -}}
	reqBody, err := io.ReadAll(r.Body)
	if err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to read request data: %w", err))
		return
	}
	defer r.Body.Close()

	{{ if $method.Succinct }}
	{{- $input := index $method.Inputs 0 -}}
	reqPayload := {{$input.Type}}{}
	{{- else }}
	reqPayload := struct {
	{{- range $i, $input := $method.Inputs}}
		Arg{{$i}} {{template "field" dict "Name" $input.Name "Type" $input.Type "Optional" $input.Optional "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $input.Meta "JsonTags" true}}
	{{- end}}
	}{}
	{{ end }}
	if err := {{$json}}.Unmarshal(reqBody, &reqPayload); err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcBadRequest.WithCausef("failed to unmarshal request data: %w", err))
		return
	}
	{{- end }}

	f, ok := w.(http.Flusher)
	if !ok {
		s.sendErrorJSON(w, r, ErrWebrpcInternalError.WithCausef("server http.ResponseWriter doesn't support .Flush() method"))
		return
	}

	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("Connection", "keep-alive")
	w.Header().Set("Content-Type", "application/x-ndjson")
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.WriteHeader(http.StatusOK)

	e := {{$json}}.NewEncoder(w)
	e.SetIndent("", "")
	streamWriter := &{{firstLetterToLower $method.Name}}StreamWriter{streamWriter{w: w, f: f, e: e, sendError: s.sendErrorJSON}}
	if err := streamWriter.ping(); err != nil {
		s.sendErrorJSON(w, r, ErrWebrpcStreamLost.WithCausef("failed to establish SSE stream: %w", err))
		return
	}

	ctx, cancel := context.WithCancel(ctx)
	defer cancel()

	go streamWriter.keepAlive(ctx)

	// Call service method implementation.
	if err {{if or (eq (len $method.Inputs) 0) (gt (len $method.Outputs) 0)}}:{{end}}= s.{{$name}}Server.{{$method.Name}}(ctx{{range $i, $_ := $method.Inputs}}, {{ if $method.Succinct }}reqPayload{{ else }}reqPayload.Arg{{$i}}{{ end }}{{end}}, streamWriter); err != nil {
		cancel()
		rpcErr, ok := err.(WebRPCError)
		if !ok {
			rpcErr = ErrWebrpcEndpoint.WithCause(err)
		}
		streamWriter.mu.Lock()
		streamWriter.sendError(w, r, rpcErr)
		streamWriter.f.Flush()
		streamWriter.mu.Unlock()
		return
	}
}
{{- end}}
{{- end}}

func (s *{{$serviceName}}) sendErrorJSON(w http.ResponseWriter, r *http.Request, rpcErr WebRPCError) {
	if s.OnError != nil {
		s.OnError(r, &rpcErr)
	}

	{{ if $opts.streaming -}}
	if w.Header().Get("Content-Type") == "application/x-ndjson" {
		out := struct {
			WebRPCError WebRPCError `json:"webrpcError"`
		}{ WebRPCError: rpcErr }
		{{$json}}.NewEncoder(w).Encode(out)
		return	
	}
	{{- end }}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(rpcErr.HTTPStatus)

	respBody, _ := {{$json}}.Marshal(rpcErr)
	w.Write(respBody)
}
{{- end}}

// Server bundles one handler impl per service; a nil field is not mounted.
type Server struct {
{{- range $_, $service := $services}}
	{{$service.Name}} {{$typePrefix}}{{$service.Name}}Server
{{- end}}
}

// Methods returns the routes of every non-nil service, for explicit per-method mounting.
func (s Server) Methods(opts *Options) []Method {
	var out []Method
	appendIf := func(set bool, srv interface{ Methods() []Method }) {
		if set {
			out = append(out, srv.Methods()...)
		}
	}
{{- range $_, $service := $services}}
	appendIf(s.{{$service.Name}} != nil, New{{firstLetterToUpper $service.Name}}Server(s.{{$service.Name}}, opts))
{{- end}}
	return out
}

func RespondWithError(w http.ResponseWriter, err error) {
	rpcErr, ok := err.(WebRPCError)
	if !ok {
		rpcErr = ErrWebrpcEndpoint.WithCause(err)
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(rpcErr.HTTPStatus)

	respBody, _ := {{$json}}.Marshal(rpcErr)
	w.Write(respBody)
}

{{ if $hasSuccinct -}}
type sendErrorFunc func(w http.ResponseWriter, r *http.Request, rpcErr WebRPCError)

func succinctHandler[I any, O any](method string, fn func(context.Context, I) (O, error), sendError sendErrorFunc) func(ctx context.Context, w http.ResponseWriter, r *http.Request) {
	return func(ctx context.Context, w http.ResponseWriter, r *http.Request) {
		ctx = context.WithValue(ctx, MethodNameCtxKey, method)

		reqBody, err := io.ReadAll(r.Body)
		if err != nil {
			sendError(w, r, ErrWebrpcBadRequest.WithCausef("failed to read request data: %w", err))
			return
		}
		defer r.Body.Close()

		var reqPayload I
		if err := {{$json}}.Unmarshal(reqBody, &reqPayload); err != nil {
			sendError(w, r, ErrWebrpcBadRequest.WithCausef("failed to unmarshal request data: %w", err))
			return
		}

		respPayload, err := fn(ctx, reqPayload)
		if err != nil {
			rpcErr, ok := err.(WebRPCError)
			if !ok {
				rpcErr = ErrWebrpcEndpoint.WithCause(err)
			}
			sendError(w, r, rpcErr)
			return
		}

		{{ if $opts.fixEmptyArrays -}}
		respBody, err := {{$json}}.Marshal(initializeNilSlices(respPayload))
		{{ else -}}
		respBody, err := {{$json}}.Marshal(respPayload)
		{{ end -}}
		if err != nil {
			sendError(w, r, ErrWebrpcBadResponse.WithCausef("failed to marshal json response: %w", err))
			return
		}

		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		w.Write(respBody)
	}
}
{{ end -}}

