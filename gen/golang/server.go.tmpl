func (s *{{$serviceName}}) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	defer func() {
		// In case of a panic, serve a HTTP 500 error and then panic.
		if rr := recover(); rr != nil {
			s.sendErrorJSON(w, r, ErrWebrpcServerPanic.WithCausef("%v", rr))
			panic(rr)
		}
	}()

	w.Header().Set(WebrpcHeader, WebrpcHeaderValue)

	// One canonical escaped path for the whole dispatch: static cases and
	// segment matchers compare it, so %2F stays inside one segment and
	// percent-encoded segments still match, like http.ServeMux.
	path := restEscapedPath(r.URL)

	// Method-first dispatch: one switch per verb, then static paths, then
	// segment matchers. Handlers are fully self-contained (context preamble
	// included), so this function allocates nothing on the hot path.
	switch r.Method {
	{{- range $_, $verb := $router.Verbs}}
	{{- if and $verb.Statics $verb.Params}}
	case {{if eq $verb.Verb "GET"}}"GET", "HEAD"{{else}}"{{$verb.Verb}}"{{end}}:
		switch path {
		{{- range $_, $entry := $verb.Statics}}
		case "{{$entry.Path}}":
			{{$entry.Handler}}(w, r)
		{{- end}}
		default:
			{{- range $_, $entry := $verb.Params}}
			{{- template "restMatcher" dict "Entry" $entry "Target" "path" "KeywordMap" $keywordMap}}
			{{- end}}
			s.restMiss(w, r)
		}
	{{- else if $verb.Statics}}
	case {{if eq $verb.Verb "GET"}}"GET", "HEAD"{{else}}"{{$verb.Verb}}"{{end}}:
		switch path {
		{{- range $_, $entry := $verb.Statics}}
		case "{{$entry.Path}}":
			{{$entry.Handler}}(w, r)
		{{- end}}
		default:
			s.restMiss(w, r)
		}
	{{- else}}
	case "{{$verb.Verb}}":
		{{- range $_, $entry := $verb.Params}}
		{{- template "restMatcher" dict "Entry" $entry "Target" "path" "KeywordMap" $keywordMap}}
		{{- end}}
		s.restMiss(w, r)
	{{- end}}
	{{- end}}
	default:
		s.restMiss(w, r)
	}
}
