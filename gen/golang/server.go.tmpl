// handle{{$method.Name}} serves the plain RPC method, self-contained so it works
// both in ServeHTTP's dispatch and when mounted on an external mux.
func (s *{{$serviceName}}) handle{{$method.Name}}(w http.ResponseWriter, r *http.Request) {
	r.Pattern = "{{$basepath}}{{$name}}/{{$method.Name}}" // MethodCtx resolves the method by this key.
	ctx := r.Context()
	ctx = context.WithValue(ctx, HTTPResponseWriterCtxKey, w)
	ctx = context.WithValue(ctx, HTTPRequestCtxKey, r)
	ctx = context.WithValue(ctx, ServiceNameCtxKey, "{{$service.Name}}")

	r = r.WithContext(ctx)

	if r.Method != "POST" {
		w.Header().Add("Allow", "POST") // RFC 9110.
		err := ErrWebrpcBadMethod.WithCausef("unsupported HTTP method %v (only POST is allowed)", r.Method)
		s.sendErrorJSON(w, r, err)
		return
	}

	contentType := r.Header.Get("Content-Type")
	if i := strings.Index(contentType, ";"); i >= 0 {
		contentType = contentType[:i]
	}
	contentType = strings.TrimSpace(strings.ToLower(contentType))

	switch contentType {
{{- if MethodHasFileUpload $method }}
	case "multipart/form-data":
{{- else }}
	case "application/json":
{{- end }}
		if s.OnRequest != nil {
			if err := s.OnRequest(w, r); err != nil {
				var rpcErr WebRPCError
				if !errors.As(err, &rpcErr) {
					rpcErr = ErrWebrpcEndpoint.WithCause(err)
				}
				s.sendErrorJSON(w, r, rpcErr)
				return
			}
		}
		{{"\n"}}
		{{- if MethodHasFileUpload $method }}
		s.serve{{firstLetterToUpper $method.Name}}Multipart(ctx, w, r)
		{{- else if and $method.Succinct (not $method.StreamOutput) (not (MethodHasFileDownload $method)) }}
		succinctHandler("{{$method.Name}}", s.{{$name}}Server.{{$method.Name}}, s.sendErrorJSON)(ctx, w, r)
		{{- else }}
		s.serve{{firstLetterToUpper $method.Name}}JSON{{if $method.StreamOutput}}Stream{{end}}(ctx, w, r)
		{{- end }}
	default:
{{- if MethodHasFileUpload $method }}
		err := ErrWebrpcBadRequest.WithCausef("unsupported Content-Type %q (only %s is allowed)", r.Header.Get("Content-Type"), "multipart/form-data")
{{- else }}
		err := ErrWebrpcBadRequest.WithCausef("unsupported Content-Type %q (only application/json is allowed)", r.Header.Get("Content-Type"))
{{- end }}
		s.sendErrorJSON(w, r, err)
	}
}
{{- end}}
{{- end}}
