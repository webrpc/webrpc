	{{- end}}
	{{- end}}
{{- end }}
}

func New{{firstLetterToUpper $service.Name}}Server(svc {{$typePrefix}}{{.Name}}Server, options ...*Options) *{{$serviceName}} {
	server := &{{$serviceName}}{
		{{.Name}}Server: svc,
	}
	if len(options) > 0 && options[0] != nil {
		server.OnError = options[0].OnError
		server.OnRequest = options[0].OnRequest
{{- if $serviceHasUpload }}
		server.MaxUploadSize = options[0].MaxUploadSize
{{- end }}
	}
{{- if $serviceHasRoutes }}
	{{- range $_, $method := $service.Methods}}
	{{- range $_, $route := $method.Routes}}
	{{- $routePath := RoutePath $route}}
	{{- $params := RouteParams $route}}
	{{- $argsType := printf "%s%sArgs" $serviceName (firstLetterToUpper $method.Name)}}
	{{- $resType := printf "%s%sResult" $serviceName (firstLetterToUpper $method.Name)}}
	{{- $reqType := $argsType}}
	{{- if $method.Succinct}}{{$reqType = printf "%s%s" $typePrefix (index $method.Inputs 0).Type}}{{end}}
	server.{{RouteHandlerField $route}} = restHandler("{{RoutePattern $route}}", "{{$service.Name}}", "{{$method.Name}}", {{RouteHasBody $route}}, {{RouteHasBodyFields $route}}, {{RouteRestBehavior $route}},
	{{- if $method.Succinct}}
		server.{{$name}}Server.{{$method.Name}},
	{{- else}}
		func(ctx context.Context, req {{$argsType}}) ({{$resType}}, error) {
			{{range $i, $_ := $method.Outputs}}ret{{$i}}, {{end}}err := server.{{$name}}Server.{{$method.Name}}(ctx{{range $i, $_ := $method.Inputs}}, req.Arg{{$i}}{{end}})
			return {{$resType}}{ {{- range $i, $_ := $method.Outputs}}{{if $i}}, {{end}}Ret{{$i}}: ret{{$i}}{{end}} }, err
		},
	{{- end}}
	{{- if $params}}
		func(p *restParams, req *{{$reqType}}) error {
		{{- range $_, $param := $params}}
			{{- $expr := ""}}
			{{- $matchCustom := ""}}
			{{- if $method.Succinct}}
				{{- range $_, $f := (index $method.Inputs 0).Type.Struct.Type.Fields}}
					{{- $jn := $f.Name}}
					{{- $gn := firstLetterToUpper $f.Name}}
					{{- $custom := ""}}
					{{- range $_, $meta := $f.Meta}}
						{{- if exists $meta "json"}}{{$jn = get $meta "json"}}{{end}}
						{{- if exists $meta "go.tag.json"}}{{$jn = get $meta "go.tag.json"}}{{end}}
						{{- if exists $meta "go.field.name"}}{{$gn = get $meta "go.field.name"}}{{end}}
						{{- if exists $meta "go.field.type"}}{{$custom = get $meta "go.field.type"}}{{end}}
					{{- end}}
					{{- if eq $jn $param.Name}}{{$expr = $gn}}{{$matchCustom = $custom}}{{end}}
				{{- end}}
			{{- else}}
				{{- range $i, $in := $method.Inputs}}
					{{- if eq $in.Name $param.Name}}
						{{- $expr = printf "Arg%d" $i}}
						{{- range $_, $meta := $in.Meta}}{{if exists $meta "go.field.type"}}{{$matchCustom = get $meta "go.field.type"}}{{end}}{{end}}
					{{- end}}
				{{- end}}
			{{- end}}
			{{- $isPath := ne (replaceAll $routePath (printf "{%s}" $param.Name) "") $routePath}}
			{{- $parser := "restText"}}
			{{- if $matchCustom}}{{$parser = "restJSON"}}{{if eq $param.TypeExpr "string"}}{{$parser = "restJSONString"}}{{end}}{{else if eq $param.TypeExpr "string"}}{{$parser = "restString"}}{{else if eq $param.TypeExpr "bool"}}{{$parser = "restBool"}}{{else if hasPrefix $param.TypeExpr "uint"}}{{$parser = "restUint"}}{{else if hasPrefix $param.TypeExpr "int"}}{{$parser = "restInt"}}{{else if hasPrefix $param.TypeExpr "float"}}{{$parser = "restFloat"}}{{end}}
			{{- if $isPath}}
			if err := restPath(p, "{{$param.Name}}", "{{$param.TypeExpr}}", &req.{{$expr}}, {{$parser}}); err != nil {
				return err
			}
			{{- else if $param.Repeated}}
			if err := restQueryList(p, "{{$param.Name}}", "{{$param.TypeExpr}}", &req.{{$expr}}, {{$parser}}, {{$param.Optional}}); err != nil {
				return err
			}
			{{- else if and $param.Optional $matchCustom}}
			if err := restQueryMaybe(p, "{{$param.Name}}", "{{$param.TypeExpr}}", &req.{{$expr}}, {{$parser}}); err != nil {
				return err
			}
			{{- else if $param.Optional}}
			if err := restQueryOpt(p, "{{$param.Name}}", "{{$param.TypeExpr}}", &req.{{$expr}}, {{$parser}}); err != nil {
				return err
			}
			{{- else}}
			if err := restQuery(p, "{{$param.Name}}", "{{$param.TypeExpr}}", &req.{{$expr}}, {{$parser}}); err != nil {
				return err
			}
			{{- end}}
		{{- end}}
			return nil
		},
	{{- else}}
		nil,
	{{- end}}
		server.sendErrorJSON, &server.OnRequest)
	{{- end}}
	{{- end}}
{{- end }}
	return server
}

