{{define "clientHelpers"}}

{{- $webrpcErrors := .WebrpcErrors -}}
{{- $schemaErrors := .SchemaErrors -}}
{{- $opts := .Opts -}}

// region Runtime
val WebRpcJson: Json = Json {
    ignoreUnknownKeys = true
}

data class WebRpcHttpResponse(
    val statusCode: Int,
    val body: String,
    val headers: Map<String, String> = emptyMap(),
)

interface WebRpcTransport {
    suspend fun post(
        baseUrl: String,
        path: String,
        body: String,
        headers: Map<String, String> = emptyMap(),
    ): WebRpcHttpResponse
{{- if $opts.fileUpload }}

    // postMultipart makes a multipart/form-data request: a "json" part carrying
    // [body] is sent first, followed by one part per file, streamed from
    // [WebRpcFile.body] without buffering. Each file body is closed after the
    // request is sent. The raw response is returned unconsumed; the caller
    // owns closing it.
    suspend fun postMultipart(
        baseUrl: String,
        path: String,
        body: String,
        files: List<WebRpcFilePart>,
        headers: Map<String, String> = emptyMap(),
    ): WebRpcHttpRawResponse
{{- end }}
{{- if $opts.fileDownload }}

    // postRaw makes a JSON request like [post], but returns the raw response
    // with its body left unconsumed as a byte stream, so binary file downloads
    // are not buffered or corrupted. The caller owns closing the response.
    suspend fun postRaw(
        baseUrl: String,
        path: String,
        body: String,
        headers: Map<String, String> = emptyMap(),
    ): WebRpcHttpRawResponse
{{- end }}
}

class WebRpcTransportException(
    message: String,
    cause: Throwable? = null,
) : IOException(message, cause)

{{- if $opts.okhttpTransport }}
class OkHttpWebRpcTransport(
    private val okHttpClient: OkHttpClient = OkHttpClient(),
) : WebRpcTransport {
    override suspend fun post(
        baseUrl: String,
        path: String,
        body: String,
        headers: Map<String, String>,
    ): WebRpcHttpResponse = withContext(Dispatchers.IO) {
        val request = Request.Builder()
            .url(joinUrl(baseUrl, path))
            .post(body.toRequestBody(jsonMediaType))
            .apply {
                headers.forEach { (name, value) -> addHeader(name, value) }
            }
            .build()

        try {
            okHttpClient.newCall(request).execute().use { response ->
                val responseBody = response.body?.string().orEmpty()
                val responseHeaders = response.headers.toMultimap()
                    .mapValues { (_, values) -> values.lastOrNull().orEmpty() }
                WebRpcHttpResponse(
                    statusCode = response.code,
                    body = responseBody,
                    headers = responseHeaders,
                )
            }
        } catch (exception: IOException) {
            throw WebRpcTransportException("WebRPC HTTP request failed", exception)
        }
    }
{{- if $opts.fileUpload }}

    override suspend fun postMultipart(
        baseUrl: String,
        path: String,
        body: String,
        files: List<WebRpcFilePart>,
        headers: Map<String, String>,
    ): WebRpcHttpRawResponse = withContext(Dispatchers.IO) {
        val multipartBody = MultipartBody.Builder()
            .setType(MultipartBody.FORM)
            .addFormDataPart("json", body)
            .apply {
                files.forEach { part ->
                    addFormDataPart(
                        part.name,
                        part.file.name?.takeIf { it.isNotEmpty() } ?: part.name,
                        part.file.toStreamingRequestBody(),
                    )
                }
            }
            .build()

        val request = Request.Builder()
            .url(joinUrl(baseUrl, path))
            .post(multipartBody)
            .apply {
                headers.forEach { (name, value) -> addHeader(name, value) }
            }
            .build()

        try {
            executeRaw(request)
        } finally {
            files.forEach { part -> part.file.close() }
        }
    }
{{- end }}
{{- if $opts.fileDownload }}

    override suspend fun postRaw(
        baseUrl: String,
        path: String,
        body: String,
        headers: Map<String, String>,
    ): WebRpcHttpRawResponse = withContext(Dispatchers.IO) {
        val request = Request.Builder()
            .url(joinUrl(baseUrl, path))
            .post(body.toRequestBody(jsonMediaType))
            .apply {
                headers.forEach { (name, value) -> addHeader(name, value) }
            }
            .build()

        executeRaw(request)
    }
{{- end }}
{{- if or $opts.fileUpload $opts.fileDownload }}

    // executeRaw executes the request and returns the raw response without
    // consuming its body; closing the returned response's body stream releases
    // the underlying connection.
    private fun executeRaw(request: Request): WebRpcHttpRawResponse {
        val response = try {
            okHttpClient.newCall(request).execute()
        } catch (exception: IOException) {
            throw WebRpcTransportException("WebRPC HTTP request failed", exception)
        }
        val responseHeaders = response.headers.toMultimap()
            .mapValues { (_, values) -> values.lastOrNull().orEmpty() }
        return WebRpcHttpRawResponse(
            statusCode = response.code,
            headers = responseHeaders,
            body = response.body?.byteStream(),
        )
    }
{{- end }}

    companion object {
        private val jsonMediaType = "application/json; charset=utf-8".toMediaType()
    }
}
{{- if $opts.fileUpload }}

// toStreamingRequestBody adapts a WebRpcFile to a one-shot OkHttp RequestBody
// that streams the file content without buffering it in memory.
private fun WebRpcFile.toStreamingRequestBody(): RequestBody {
    val file = this
    return object : RequestBody() {
        override fun contentType(): MediaType? = file.contentType.toMediaTypeOrNull()
        override fun contentLength(): Long = if (file.size >= 0) file.size else -1L
        override fun isOneShot(): Boolean = true
        override fun writeTo(sink: BufferedSink) {
            val body = file.body ?: return
            body.source().use { source -> sink.writeAll(source) }
        }
    }
}
{{- end }}
{{- end }}

private fun joinUrl(baseUrl: String, path: String): String =
    baseUrl.trimEnd('/') + "/" + path.trimStart('/')

suspend inline fun <O> executeWebRpc(
    baseUrl: String,
    urlPath: String,
    body: String,
    transport: WebRpcTransport,
    headers: Map<String, String> = emptyMap(),
    json: Json = WebRpcJson,
    crossinline decodeSuccess: (body: String, json: Json) -> O,
): O {
    val response = try {
        transport.post(
            baseUrl = baseUrl,
            path = urlPath,
            body = body,
            headers = headers,
        )
    } catch (e: CancellationException) {
        throw e
    } catch (e: WebRpcTransportException) {
        throw e
    } catch (e: Throwable) {
        throw WebRpcTransportException("WebRPC request failed", e)
    }

    if (response.statusCode !in 200..299) {
        throw decodeWebRpcError(response.statusCode, response.body, json)
    }

    return decodeSuccess(response.body, json)
}
// endregion

// region Errors
enum class ErrorKind(val code: Int) {

    {{- range $_, $error := $webrpcErrors}}
    {{toUpper (snakeCase $error.Name)}}({{$error.Code}}),
    {{- end }}
    {{- range $_, $error := $schemaErrors}}
    {{toUpper (snakeCase $error.Name)}}({{$error.Code}}),
    {{- end }}
    UNKNOWN(-999);

    companion object {
        fun fromCode(code: Int): ErrorKind {
            return ErrorKind.values().find { it.code == code } ?: UNKNOWN
        }
    }
}

data class WebRpcError(
    val error: String,
    val code: Int,
    override val message: String,
    val causeString: String,
    val status: Int,
    val errorKind: ErrorKind = ErrorKind.fromCode(code),
) : Exception(message)

@Serializable
private data class WebRpcErrorPayload(
    @SerialName("error") val error: String? = null,
    @SerialName("code") val code: Int? = null,
    @SerialName("msg") val message: String? = null,
    @SerialName("cause") val causeString: String? = null,
    @SerialName("status") val status: Int? = null,
)

fun decodeWebRpcError(
    statusCode: Int,
    body: String,
    json: Json = WebRpcJson,
): WebRpcError {
    return try {
        val payload = json.decodeFromString<WebRpcErrorPayload>(body)
        val code = payload.code ?: ErrorKind.UNKNOWN.code
        WebRpcError(
            error = payload.error ?: "WebrpcEndpoint",
            code = code,
            message = payload.message ?: "endpoint error",
            causeString = payload.causeString.orEmpty(),
            status = payload.status ?: statusCode,
            errorKind = ErrorKind.fromCode(code),
        )
    } catch (_: Throwable) {
        WebRpcError(
            error = "WebrpcBadResponse",
            code = ErrorKind.UNKNOWN.code,
            message = "Unable to decode error response",
            causeString = body,
            status = statusCode,
            errorKind = ErrorKind.UNKNOWN,
        )
    }
}
// endregion

{{end}}
