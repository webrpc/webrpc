// region File helpers

/**
 * WebRpcFile is a file sent to (upload) or received from (download) a webrpc
 * service.
 *
 * Uploads: construct one with [fromFile], [fromBytes] or [fromStream] and pass
 * it to the client method. The content is streamed as one multipart part (not
 * buffered in memory) and [body] is closed after the request is sent.
 *
 * Downloads: returned by the client method with [name], [contentType] and
 * [size] parsed from the response headers, and [body] streaming directly from
 * the connection. Consume it via [body] (streaming) or [bytes] (buffered) and
 * always close the file, e.g. `client.download(request).use { file -> ... }`.
 * Reading [body] is blocking I/O; on Android, read it on a background
 * dispatcher (e.g. `withContext(Dispatchers.IO)`).
 *
 * In JSON payloads a file field is always encoded as `null`: the content
 * travels as a multipart part or as the raw response body instead.
 */
@Serializable(with = WebRpcFileSerializer::class)
class WebRpcFile(
    /** filename, when known */
    val name: String? = null,
    /** MIME type as claimed by the sender */
    val contentType: String = "application/octet-stream",
    /** content size in bytes, -1 when unknown */
    val size: Long = -1L,
    /** single-use content stream owned by this file; null when there is no content */
    val body: InputStream? = null,
) : Closeable {

    /** bytes buffers the entire [body] into memory and closes this file. */
    fun bytes(): ByteArray = use { it.body?.readBytes() ?: ByteArray(0) }

    override fun close() {
        body?.close()
    }

    companion object {
        fun fromFile(
            file: File,
            contentType: String = "application/octet-stream",
            name: String = file.name,
        ): WebRpcFile = WebRpcFile(
            name = name,
            contentType = contentType,
            size = file.length(),
            body = file.inputStream(),
        )

        fun fromBytes(
            bytes: ByteArray,
            name: String? = null,
            contentType: String = "application/octet-stream",
        ): WebRpcFile = WebRpcFile(
            name = name,
            contentType = contentType,
            size = bytes.size.toLong(),
            body = bytes.inputStream(),
        )

        fun fromStream(
            stream: InputStream,
            name: String? = null,
            contentType: String = "application/octet-stream",
            size: Long = -1L,
        ): WebRpcFile = WebRpcFile(
            name = name,
            contentType = contentType,
            size = size,
            body = stream,
        )
    }
}

// WebRpcFileSerializer encodes a file as JSON null: files are never carried in
// JSON payloads, their content travels as a multipart part or as the raw
// response body instead. Decoding consumes and discards the JSON value.
object WebRpcFileSerializer : KSerializer<WebRpcFile> {
    override val descriptor: SerialDescriptor = JsonElement.serializer().descriptor

    override fun serialize(encoder: Encoder, value: WebRpcFile) {
        encoder.encodeSerializableValue(JsonElement.serializer(), JsonNull)
    }

    override fun deserialize(decoder: Decoder): WebRpcFile {
        decoder.decodeSerializableValue(JsonElement.serializer())
        return WebRpcFile()
    }
}
