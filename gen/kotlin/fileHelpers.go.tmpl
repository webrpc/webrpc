// WebRpcHttpRawResponse is an HTTP response whose body is kept as a raw byte
// stream, so binary file content can be consumed without buffering. Closing
// the response closes the body stream and releases the underlying connection.
class WebRpcHttpRawResponse(
    val statusCode: Int,
    val headers: Map<String, String> = emptyMap(),
    val body: InputStream? = null,
) : Closeable {
    override fun close() {
        body?.close()
    }
}

// readWebRpcResponseBody buffers the entire response body as an UTF-8 string
// and closes the response.
suspend fun readWebRpcResponseBody(response: WebRpcHttpRawResponse): String =
    withContext(Dispatchers.IO) {
        try {
            response.use { it.body?.readBytes()?.toString(Charsets.UTF_8).orEmpty() }
        } catch (e: IOException) {
            throw WebRpcTransportException("WebRPC failed to read response body", e)
        }
    }
{{- end }}
{{- if and $opts.client $opts.fileUpload }}

// WebRpcFilePart is one file-carrying part of a multipart upload request body.
// Repeated ([]file) arguments produce one part per file, all sharing the same
// part name.
data class WebRpcFilePart(
    val name: String,
    val file: WebRpcFile,
)

suspend inline fun <O> executeWebRpcUpload(
    baseUrl: String,
    urlPath: String,
    body: String,
    files: List<WebRpcFilePart>,
    transport: WebRpcTransport,
    headers: Map<String, String> = emptyMap(),
    json: Json = WebRpcJson,
    crossinline decodeSuccess: (body: String, json: Json) -> O,
): O {
    val response = try {
        transport.postMultipart(
            baseUrl = baseUrl,
            path = urlPath,
            body = body,
            files = files,
            headers = headers,
        )
    } catch (e: CancellationException) {
        throw e
    } catch (e: WebRpcTransportException) {
        throw e
    } catch (e: Throwable) {
        throw WebRpcTransportException("WebRPC request failed", e)
    }

    val responseBody = readWebRpcResponseBody(response)
    if (response.statusCode !in 200..299) {
        throw decodeWebRpcError(response.statusCode, responseBody, json)
    }

    return decodeSuccess(responseBody, json)
}
{{- end }}
