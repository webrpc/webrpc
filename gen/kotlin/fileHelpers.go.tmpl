suspend fun executeWebRpcDownload(
    baseUrl: String,
    urlPath: String,
    body: String,
    transport: WebRpcTransport,
    headers: Map<String, String> = emptyMap(),
    json: Json = WebRpcJson,
): WebRpcFile {
    val response = try {
        transport.postRaw(
            baseUrl = baseUrl,
            path = urlPath,
            body = body,
            headers = headers,
        )
    } catch (e: CancellationException) {
        throw e
    } catch (e: WebRpcTransportException) {
        throw e
    } catch (e: Throwable) {
        throw WebRpcTransportException("WebRPC request failed", e)
    }

    return decodeWebRpcFileResponse(response, json)
}
