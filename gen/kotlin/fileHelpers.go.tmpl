// decodeWebRpcFileResponse wraps a successful raw response as a WebRpcFile
// streaming the response body, or throws the decoded WebRpcError carried by a
// non-2xx response.
private suspend fun decodeWebRpcFileResponse(response: WebRpcHttpRawResponse, json: Json): WebRpcFile {
    if (response.statusCode !in 200..299) {
        throw decodeWebRpcError(response.statusCode, readWebRpcResponseBody(response), json)
    }

    val contentType = webRpcResponseHeader(response.headers, "Content-Type").orEmpty()
    return WebRpcFile(
        name = fileNameFromContentDisposition(webRpcResponseHeader(response.headers, "Content-Disposition")),
        contentType = contentType.ifEmpty { "application/octet-stream" },
        size = webRpcResponseHeader(response.headers, "Content-Length")
            ?.takeIf { it.isNotEmpty() && it.all { char -> char.isDigit() } }
            ?.toLongOrNull() ?: -1L,
        body = response.body,
    )
}

private fun webRpcResponseHeader(headers: Map<String, String>, name: String): String? =
    headers[name] ?: headers.entries.firstOrNull { it.key.equals(name, ignoreCase = true) }?.value

// fileNameFromContentDisposition extracts the filename of a Content-Disposition
// header: the RFC 5987 `filename*=utf-8''...` parameter when present, then the
// quoted and plain `filename=` parameters.
private fun fileNameFromContentDisposition(header: String?): String? {
    if (header.isNullOrEmpty()) {
        return null
    }
    // RFC 5987 extended parameter, e.g. filename*=utf-8''na%C3%AFve.png
    val extended = Regex("filename\\*=utf-8''([^;]*)", RegexOption.IGNORE_CASE)
        .find(header)?.groupValues?.get(1)?.trim()
    if (!extended.isNullOrEmpty()) {
        try {
            // Protect '+' from URLDecoder's form-decoding: RFC 5987 values are
            // percent-encoded, where '+' is a literal plus sign.
            return URLDecoder.decode(extended.replace("+", "%2B"), "UTF-8")
        } catch (_: Exception) {
        }
    }
    val quoted = Regex("filename=\"((?:[^\"\\\\]|\\\\.)*)\"").find(header)?.groupValues?.get(1)
    if (!quoted.isNullOrEmpty()) {
        return quoted.replace(Regex("\\\\(.)"), "$1")
    }
    val plain = Regex("filename=([^;]+)").find(header)?.groupValues?.get(1)?.trim()
    if (!plain.isNullOrEmpty()) {
        return plain
    }
    return null
}
