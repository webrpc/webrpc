{{- define "client" -}}
{{- $ctx := .Ctx -}}
{{- $opts := $ctx.Opts -}}
{{- $vis := $opts.visibility -}}

{{- range $_, $service := .Services }}
{{- $clientName := printf "%sClient" $service.Name }}
{{ template "doc" dict "Comments" $service.Comments "Indent" "    " }}
    {{$vis}} interface I{{$clientName}}
    {
        {{- range $i, $method := $service.Methods }}
        {{- if $i }}
{{ end }}
        {{- template "methodDoc" dict "Method" $method }}
        {{ template "methodSignature" dict "Method" $method "ClientName" $clientName "Ctx" $ctx }};
        {{- end }}
    }
{{ template "doc" dict "Comments" $service.Comments "Indent" "    " }}
    {{$vis}} partial class {{$clientName}} : I{{$clientName}}
    {
        private readonly string _baseUrl;
        private readonly global::System.Net.Http.HttpClient _httpClient;

        /// <summary>Creates a {{$service.Name}} client.</summary>
        /// <param name="baseUrl">The server URL, eg. "https://api.example.com".</param>
        /// <param name="httpClient">
        /// The HTTP client sending the requests. Add a DelegatingHandler to it to
        /// customize requests (eg. authentication headers) or the transport.
        /// </param>
        public {{$clientName}}(string baseUrl, global::System.Net.Http.HttpClient httpClient)
        {
            if (baseUrl == null)
            {
                throw new global::System.ArgumentNullException(nameof(baseUrl));
            }
            _baseUrl = baseUrl.TrimEnd('/');
            _httpClient = httpClient ?? throw new global::System.ArgumentNullException(nameof(httpClient));
        }
        {{- range $_, $method := $service.Methods }}
        {{- $route := MethodCanonicalRoute $method }}
        {{- $hasOutputObject := and (not $method.Succinct) (not (MethodHasFileDownload $method)) (gt (len $method.Outputs) 0) }}
{{ template "methodDoc" dict "Method" $method }}
        public async {{ template "methodSignature" dict "Method" $method "ClientName" $clientName "Ctx" $ctx "Impl" true }}
        {
            {{- /* Request body. */ -}}
            {{- if and (MethodHasRoute $method) (not (RouteHasBody $route)) }}
            {{- else if $method.Succinct }}
            var __json = WebrpcJson.Serialize(request);
            {{- else if $method.Inputs }}
            var __args = new global::System.Collections.Generic.Dictionary<string, object?>();
            {{- range $_, $input := $method.Inputs }}
            {{- if $input.Optional }}
            if ({{ template "argName" dict "Name" $input.Name "Method" $method "Ctx" $ctx }} != null)
            {
                __args[{{ template "str" $input.Name }}] = {{ template "argName" dict "Name" $input.Name "Method" $method "Ctx" $ctx }};
            }
            {{- else }}
            __args[{{ template "str" $input.Name }}] = {{ template "argName" dict "Name" $input.Name "Method" $method "Ctx" $ctx }};
            {{- end }}
            {{- end }}
            var __json = WebrpcJson.Serialize(__args);
            {{- else }}
            var __json = "{}";
            {{- end }}

            {{- /* Request URL. */ -}}
            {{- if MethodHasRoute $method }}
            {{- $routePath := RoutePath $route }}
            var __url = new WebrpcRestUrl();
            {{- range $_, $param := RouteParams $route }}
            {{ template "restParam" dict "Param" $param "Method" $method "RoutePath" $routePath "Ctx" $ctx }}
            {{- end }}
            using (var __request = WebrpcHttp.NewRequest(new global::System.Net.Http.HttpMethod({{ template "str" $route.Verb }}), __url.Build(_baseUrl, {{ template "str" $routePath }}), {{ if RouteHasBody $route }}WebrpcHttp.JsonContent(__json){{ else }}null{{ end }}))
            {{- else }}
            {{- if MethodHasFileUpload $method }}
            var __content = new WebrpcMultipartContent(__json);
            {{- range $_, $part := MethodFileParts $method }}
            {{ template "filePart" dict "Part" $part "Method" $method "Ctx" $ctx }}
            {{- end }}
            {{- end }}
            using (var __request = WebrpcHttp.NewRequest(global::System.Net.Http.HttpMethod.Post, _baseUrl + {{ template "str" (printf "%s%s/%s" $service.Schema.BasePath $service.Name $method.Name) }}, {{ if MethodHasFileUpload $method }}__content{{ else }}WebrpcHttp.JsonContent(__json){{ end }}))
            {{- end }}
            {
            {{- /* Response. */ -}}
            {{- if $method.StreamOutput }}
                var __response = await WebrpcHttp.OpenAsync(_httpClient, __request, cancellationToken).ConfigureAwait(false);
                await foreach (var __message in global::System.Threading.Tasks.TaskAsyncEnumerableExtensions.ConfigureAwait(WebrpcHttp.ReadStreamAsync<{{ if $method.Succinct }}{{ template "type" dict "Type" (index $method.Outputs 0).Type "Ctx" $ctx }}{{ else }}{{$method.Name}}Response{{ end }}>(__response, cancellationToken), false))
                {
                    {{- if and (not $method.Succinct) (eq (len $method.Outputs) 1) }}
                    yield return __message.{{ template "propName" dict "Name" (index $method.Outputs 0).Name "Owner" (printf "%sResponse" $method.Name) "Ctx" $ctx }};
                    {{- else }}
                    yield return __message;
                    {{- end }}
                }
            {{- else if MethodHasFileDownload $method }}
                var __response = await WebrpcHttp.OpenAsync(_httpClient, __request, cancellationToken).ConfigureAwait(false);
                return await WebrpcHttp.ReadFileAsync(__response).ConfigureAwait(false);
            {{- else if $method.Succinct }}
                return await WebrpcHttp.CallAsync<{{ template "type" dict "Type" (index $method.Outputs 0).Type "Ctx" $ctx }}>(_httpClient, __request, {{ if MethodHasEmptyResponse $method }}true{{ else }}false{{ end }}, cancellationToken).ConfigureAwait(false);
            {{- else if eq (len $method.Outputs) 0 }}
                await WebrpcHttp.CallAsync(_httpClient, __request, cancellationToken).ConfigureAwait(false);
            {{- else if eq (len $method.Outputs) 1 }}
                var __response = await WebrpcHttp.CallAsync<{{$method.Name}}Response>(_httpClient, __request, false, cancellationToken).ConfigureAwait(false);
                return __response.{{ template "propName" dict "Name" (index $method.Outputs 0).Name "Owner" (printf "%sResponse" $method.Name) "Ctx" $ctx }};
            {{- else }}
                return await WebrpcHttp.CallAsync<{{$method.Name}}Response>(_httpClient, __request, false, cancellationToken).ConfigureAwait(false);
            {{- end }}
            }
        }
        {{- if $hasOutputObject }}

        {{ if gt (len $method.Outputs) 1 }}public{{ else }}private{{ end }} sealed partial class {{$method.Name}}Response
        {
            {{- range $i, $output := $method.Outputs }}
            {{- if $i }}
{{ end }}
            {{ template "jsonProperty" dict "Name" $output.Name "Optional" $output.Optional "Ctx" $ctx }}
            public {{ template "fieldType" dict "Type" $output.Type "Optional" $output.Optional "Ctx" $ctx }} {{ template "propName" dict "Name" $output.Name "Owner" (printf "%sResponse" $method.Name) "Ctx" $ctx }} { get; set; }{{ template "initializer" dict "Type" $output.Type "Optional" $output.Optional "Ctx" $ctx }}
            {{- end }}
        }
        {{- end }}
        {{- end }}
    }
{{- end }}
{{- end -}}

{{- define "methodDoc" -}}
{{- $method := .Method -}}
{{- template "doc" dict "Comments" $method.Comments "Indent" "        " }}
{{- $deprecated := index $method.Annotations "deprecated" }}
{{- if $deprecated }}
        [global::System.Obsolete{{ if $deprecated.Value }}({{ template "str" $deprecated.Value }}){{ end }}]
{{- end }}
{{- end -}}

{{- /* methodSignature renders "ReturnType NameAsync(args, cancellationToken)". */ -}}
{{- define "methodSignature" -}}
{{- $method := .Method -}}
{{- $ctx := .Ctx -}}
{{- if $method.StreamOutput -}}
global::System.Collections.Generic.IAsyncEnumerable<
  {{- if $method.Succinct }}{{ template "type" dict "Type" (index $method.Outputs 0).Type "Ctx" $ctx }}
  {{- else if eq (len $method.Outputs) 1 }}{{ template "fieldType" dict "Type" (index $method.Outputs 0).Type "Optional" (index $method.Outputs 0).Optional "Ctx" $ctx }}
  {{- else }}{{ $ctx.Ns }}.{{ .ClientName }}.{{ $method.Name }}Response{{ end -}}
>
{{- else if MethodHasFileDownload $method -}}
global::System.Threading.Tasks.Task<{{ $ctx.Ns }}.WebrpcFile>
{{- else if $method.Succinct -}}
global::System.Threading.Tasks.Task<{{ template "type" dict "Type" (index $method.Outputs 0).Type "Ctx" $ctx }}>
{{- else if eq (len $method.Outputs) 0 -}}
global::System.Threading.Tasks.Task
{{- else if eq (len $method.Outputs) 1 -}}
global::System.Threading.Tasks.Task<{{ template "fieldType" dict "Type" (index $method.Outputs 0).Type "Optional" (index $method.Outputs 0).Optional "Ctx" $ctx }}>
{{- else -}}
global::System.Threading.Tasks.Task<{{ $ctx.Ns }}.{{ .ClientName }}.{{ $method.Name }}Response>
{{- end }} {{ $method.Name }}Async(
{{- if $method.Succinct -}}
{{ template "type" dict "Type" (index $method.Inputs 0).Type "Ctx" $ctx }} request{{ ", " }}
{{- else -}}
{{- range $_, $input := $method.Inputs -}}
{{ template "fieldType" dict "Type" $input.Type "Optional" $input.Optional "Ctx" $ctx }} {{ template "argName" dict "Name" $input.Name "Method" $method "Ctx" $ctx }}{{ ", " }}
{{- end -}}
{{- end -}}
{{ if and .Impl $method.StreamOutput }}[global::System.Runtime.CompilerServices.EnumeratorCancellation] {{ end }}global::System.Threading.CancellationToken cancellationToken = default)
{{- end -}}

{{- /* restParam renders the statement binding a request field to a REST path or query param. */ -}}
{{- define "restParam" -}}
{{- $param := .Param -}}
{{- $method := .Method -}}
{{- $ctx := .Ctx -}}
__url.
{{- if ne (replace (printf "{%s}" $param.Name) "" .RoutePath) .RoutePath }}SetPath
{{- else if $param.Repeated }}AddQueryList
{{- else }}AddQuery
{{- end }}({{ template "str" $param.Name }}{{ ", " }}
{{- if $method.Succinct -}}
  {{- $input := index $method.Inputs 0 -}}
  {{- range $_, $field := $input.Type.Struct.Type.Fields -}}
    {{- $jsonName := $field.Name -}}
    {{- range $_, $meta := $field.Meta }}{{ if exists $meta "json" }}{{ $jsonName = printf "%v" (get $meta "json") }}{{ end }}{{ end -}}
    {{- if eq $jsonName $param.Name }}request.{{ template "propName" dict "Name" $field.Name "Owner" (printf "%v" $input.Type) "Ctx" $ctx }}{{ end -}}
  {{- end -}}
{{- else -}}
{{ template "argName" dict "Name" $param.Name "Method" $method "Ctx" $ctx }}
{{- end -}}
);
{{- end -}}

{{- /* filePart renders the statement adding a file argument to a multipart upload. */ -}}
{{- define "filePart" -}}
{{- $part := .Part -}}
{{- $method := .Method -}}
{{- $ctx := .Ctx -}}
__content.Add{{ if $part.Repeated }}Files{{ else }}File{{ end }}({{ template "str" $part.PartName }}{{ ", " }}
{{- range $_, $input := $method.Inputs -}}
  {{- if eq $input.Name $part.ArgName -}}
    {{- if $method.Succinct }}request{{ else }}{{ template "argName" dict "Name" $input.Name "Method" $method "Ctx" $ctx }}{{ end -}}
    {{- if ne $part.FieldName "" -}}
      {{- range $_, $field := $input.Type.Struct.Type.Fields -}}
        {{- $jsonName := $field.Name -}}
        {{- range $_, $meta := $field.Meta }}{{ if exists $meta "json" }}{{ $jsonName = printf "%v" (get $meta "json") }}{{ end }}{{ end -}}
        {{- if eq $jsonName $part.PartName }}?.{{ template "propName" dict "Name" $field.Name "Owner" (printf "%v" $input.Type) "Ctx" $ctx }}{{ end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
);
{{- end -}}
