        // Wraps a successful response as a file; disposing the file disposes the response.
        internal static async global::System.Threading.Tasks.Task<WebrpcFile> ReadFileAsync(global::System.Net.Http.HttpResponseMessage response)
        {
            try
            {
                var headers = response.Content.Headers;
                var body = await response.Content.ReadAsStreamAsync().ConfigureAwait(false);
                var name = headers.ContentDisposition?.FileNameStar;
                if (string.IsNullOrEmpty(name))
                {
                    name = Unquote(headers.ContentDisposition?.FileName);
                }
                return new WebrpcFile(body, string.IsNullOrEmpty(name) ? null : name, headers.ContentType?.ToString(), headers.ContentLength, response);
            }
            catch (global::System.Exception ex)
            {
                response.Dispose();
                throw new WebrpcBadResponseException("WebrpcBadResponse", "bad response", (int)response.StatusCode, "failed to read file response: " + ex.Message, ex);
            }
        }

        private static string? Unquote(string? value)
        {
            if (value == null || value.Length < 2 || value[0] != '"' || value[value.Length - 1] != '"')
            {
                return value;
            }
            var text = new global::System.Text.StringBuilder(value.Length);
            for (var i = 1; i < value.Length - 1; i++)
            {
                if (value[i] == '\\' && i + 1 < value.Length - 1)
                {
                    i++;
                }
                text.Append(value[i]);
            }
            return text.ToString();
        }
