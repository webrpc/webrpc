    // Builds the URL of a REST route: path params fill the {name} placeholders,
    // the other GET/DELETE request fields travel as query params.
    internal sealed class WebrpcRestUrl
    {
        private readonly global::System.Collections.Generic.Dictionary<string, string> _path = new global::System.Collections.Generic.Dictionary<string, string>();
        private readonly global::System.Text.StringBuilder _query = new global::System.Text.StringBuilder();

        public void SetPath(string name, object? value)
        {
            _path[name] = value == null ? "" : Format(value);
        }

        public void AddQuery(string name, object? value)
        {
            if (value == null)
            {
                return;
            }
            _query.Append(_query.Length == 0 ? '?' : '&');
            _query.Append(global::System.Uri.EscapeDataString(name));
            _query.Append('=');
            _query.Append(global::System.Uri.EscapeDataString(Format(value)));
        }

        public void AddQueryList<T>(string name, global::System.Collections.Generic.IEnumerable<T>? values)
        {
            if (values == null)
            {
                return;
            }
            foreach (var value in values)
            {
                AddQuery(name, value);
            }
        }

        // Expands the {name} placeholders in one pass, so a value is never expanded again.
        public string Build(string baseUrl, string route)
        {
            var url = new global::System.Text.StringBuilder(baseUrl);
            var pos = 0;
            while (pos < route.Length)
            {
                var open = route.IndexOf('{', pos);
                if (open < 0)
                {
                    url.Append(route, pos, route.Length - pos);
                    break;
                }
                var close = route.IndexOf('}', open);
                if (close < 0)
                {
                    throw new WebrpcBadRequestException("unclosed placeholder in route " + route);
                }
                var name = route.Substring(open + 1, close - open - 1);
                _path.TryGetValue(name, out var value);
                // A dot segment is normalized away by URL parsers, and encoding can't fix it.
                if (string.IsNullOrEmpty(value) || value == "." || value == "..")
                {
                    throw new WebrpcBadRequestException("invalid path param '" + name + "': \"" + value + "\" is not a valid path segment");
                }
                url.Append(route, pos, open - pos);
                url.Append(global::System.Uri.EscapeDataString(value));
                pos = close + 1;
            }
            url.Append(_query);
            return url.ToString();
        }

        // Formats a route param the way webrpc servers parse it.
        private static string Format(object value)
        {
            switch (value)
            {
                case string s:
                    return s;
                case bool b:
                    return b ? "true" : "false";
                case float f:
                    return f.ToString("R", global::System.Globalization.CultureInfo.InvariantCulture);
                case double d:
                    return d.ToString("R", global::System.Globalization.CultureInfo.InvariantCulture);
                case global::System.DateTimeOffset t:
                    return WebrpcTimestamp.Format(t);
                case global::System.IFormattable formattable:
                    return formattable.ToString(null, global::System.Globalization.CultureInfo.InvariantCulture);
                default:
                    return value.ToString() ?? "";
            }
        }
    }
