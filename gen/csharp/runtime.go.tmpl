        // Reads a stream of newline-delimited JSON messages; empty lines are
        // keep-alive pings. The stream ends when the server closes it.
        internal static async global::System.Collections.Generic.IAsyncEnumerable<T> ReadStreamAsync<T>(global::System.Net.Http.HttpResponseMessage response, [global::System.Runtime.CompilerServices.EnumeratorCancellation] global::System.Threading.CancellationToken cancellationToken)
            where T : class, new()
        {
            using (response)
            using (cancellationToken.Register(response.Dispose))
            {
                var body = await response.Content.ReadAsStreamAsync().ConfigureAwait(false);
                using (var reader = new global::System.IO.StreamReader(body, new global::System.Text.UTF8Encoding(false)))
                {
                    while (true)
                    {
                        cancellationToken.ThrowIfCancellationRequested();
                        var line = await ReadLineAsync(reader, cancellationToken).ConfigureAwait(false);
                        if (line == null)
                        {
                            yield break;
                        }
                        if (line.Trim().Length == 0)
                        {
                            continue;
                        }
                        yield return DecodeStreamMessage<T>(line, (int)response.StatusCode);
                    }
                }
            }
        }

        private static async global::System.Threading.Tasks.Task<string?> ReadLineAsync(global::System.IO.StreamReader reader, global::System.Threading.CancellationToken cancellationToken)
        {
            try
            {
                return await reader.ReadLineAsync().ConfigureAwait(false);
            }
            catch (global::System.Exception ex) when (!(ex is WebrpcException))
            {
                cancellationToken.ThrowIfCancellationRequested();
                throw new WebrpcStreamLostException("WebrpcStreamLost", "stream lost", 400, "reading stream: " + ex.Message, ex);
            }
        }

        private static T DecodeStreamMessage<T>(string line, int status)
            where T : class, new()
        {
            WebrpcStreamError? streamError = null;
            T? message;
            try
            {
                if (line.IndexOf("\"webrpcError\"", global::System.StringComparison.Ordinal) >= 0)
                {
                    streamError = WebrpcJson.Deserialize<WebrpcStreamError?>(line);
                }
                message = streamError?.WebrpcError == null ? WebrpcJson.Deserialize<T?>(line) : null;
            }
            catch (global::System.Exception ex)
            {
                throw new WebrpcBadResponseException("WebrpcBadResponse", "bad response", status, "failed to unmarshal JSON stream message: " + ex.Message, ex);
            }
            if (streamError?.WebrpcError != null)
            {
                throw WebrpcException.FromEnvelope(streamError.WebrpcError, 400);
            }
            return message ?? new T();
        }
        {{- end }}

        private static async global::System.Threading.Tasks.Task<string> ReadBodyAsync(global::System.Net.Http.HttpResponseMessage response)
        {
            try
            {
                return response.Content == null ? "" : await response.Content.ReadAsStringAsync().ConfigureAwait(false);
            }
            catch (global::System.Exception ex)
            {
                throw new WebrpcBadResponseException("WebrpcBadResponse", "bad response", (int)response.StatusCode, "failed to read response body: " + ex.Message, ex);
            }
        }

        // Decodes the JSON error response of a webrpc server.
        internal static WebrpcException DecodeError(int status, string body)
        {
            WebrpcErrorEnvelope? envelope = null;
            global::System.Exception? error = null;
            try
            {
                envelope = WebrpcJson.Deserialize<WebrpcErrorEnvelope?>(body);
            }
            catch (global::System.Exception ex)
            {
                error = ex;
            }
            if (envelope == null)
            {
                var text = body.Length > 512 ? body.Substring(0, 512) + "..." : body;
                return new WebrpcBadResponseException("WebrpcBadResponse", "bad response", status, "failed to unmarshal server error (HTTP " + status + "): " + text, error);
            }
            return WebrpcException.FromEnvelope(envelope, status);
        }
    }
