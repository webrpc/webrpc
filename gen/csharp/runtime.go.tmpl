        // Sends a request and returns the response once its headers arrive, so
        // the body can be streamed. The caller must dispose the response.
        internal static async global::System.Threading.Tasks.Task<global::System.Net.Http.HttpResponseMessage> OpenAsync(global::System.Net.Http.HttpClient client, global::System.Net.Http.HttpRequestMessage request, global::System.Threading.CancellationToken cancellationToken)
        {
            var response = await SendAsync(client, request, global::System.Net.Http.HttpCompletionOption.ResponseHeadersRead, cancellationToken).ConfigureAwait(false);
            var status = (int)response.StatusCode;
            if (status < 200 || status > 299)
            {
                using (response)
                {
                    throw DecodeError(status, await ReadBodyAsync(response).ConfigureAwait(false));
                }
            }
            return response;
        }
        {{- end }}
