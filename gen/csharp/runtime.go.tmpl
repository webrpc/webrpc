    // A multipart/form-data request body: the "json" part with the JSON-encoded
    // arguments goes first, then one part per file. Files are streamed, not buffered.
    internal sealed class WebrpcMultipartContent : global::System.Net.Http.HttpContent
    {
        private static readonly global::System.Text.Encoding Utf8 = new global::System.Text.UTF8Encoding(false);

        private readonly string _boundary = "webrpc-" + global::System.Guid.NewGuid().ToString("N");
        private readonly byte[] _json;
        private readonly global::System.Collections.Generic.List<global::System.Collections.Generic.KeyValuePair<string, WebrpcFile>> _files = new global::System.Collections.Generic.List<global::System.Collections.Generic.KeyValuePair<string, WebrpcFile>>();

        public WebrpcMultipartContent(string json)
        {
            _json = Utf8.GetBytes(json);
            Headers.ContentType = global::System.Net.Http.Headers.MediaTypeHeaderValue.Parse("multipart/form-data; boundary=" + _boundary);
        }

        public void AddFile(string name, WebrpcFile? file)
        {
            if (file != null)
            {
                _files.Add(new global::System.Collections.Generic.KeyValuePair<string, WebrpcFile>(name, file));
            }
        }

        public void AddFiles(string name, global::System.Collections.Generic.IEnumerable<WebrpcFile>? files)
        {
            if (files == null)
            {
                return;
            }
            foreach (var file in files)
            {
                AddFile(name, file);
            }
        }

        protected override async global::System.Threading.Tasks.Task SerializeToStreamAsync(global::System.IO.Stream stream, global::System.Net.TransportContext? context)
        {
            await WriteAsync(stream, JsonPartHeader()).ConfigureAwait(false);
            await stream.WriteAsync(_json, 0, _json.Length).ConfigureAwait(false);
            foreach (var file in _files)
            {
                await WriteAsync(stream, FilePartHeader(file.Key, file.Value)).ConfigureAwait(false);
                await file.Value.Body.CopyToAsync(stream).ConfigureAwait(false);
            }
            await WriteAsync(stream, Trailer()).ConfigureAwait(false);
        }

        protected override bool TryComputeLength(out long length)
        {
            length = Utf8.GetByteCount(JsonPartHeader()) + _json.Length + Utf8.GetByteCount(Trailer());
            foreach (var file in _files)
            {
                var body = file.Value.Body;
                if (!body.CanSeek)
                {
                    length = -1;
                    return false;
                }
                length += Utf8.GetByteCount(FilePartHeader(file.Key, file.Value)) + (body.Length - body.Position);
            }
            return true;
        }

        private string JsonPartHeader()
        {
            return "--" + _boundary + "\r\nContent-Disposition: form-data; name=\"json\"\r\n\r\n";
        }

        private string FilePartHeader(string name, WebrpcFile file)
        {
            var fileName = string.IsNullOrEmpty(file.Name) ? name : file.Name!;
            // NOTE: the name and filename params are always quoted, like browsers
            // do; unquoted params are rejected by strict multipart parsers.
            return "\r\n--" + _boundary + "\r\nContent-Disposition: form-data; name=\"" + Escape(name) + "\"; filename=\"" + Escape(fileName) + "\"\r\nContent-Type: " + StripNewlines(file.ContentType) + "\r\n\r\n";
        }

        private string Trailer()
        {
            return "\r\n--" + _boundary + "--\r\n";
        }

        private static string Escape(string value)
        {
            return StripNewlines(value.Replace("\\", "\\\\").Replace("\"", "\\\""));
        }

        private static string StripNewlines(string value)
        {
            return value.Replace("\r", "%0D").Replace("\n", "%0A");
        }

        private static global::System.Threading.Tasks.Task WriteAsync(global::System.IO.Stream stream, string text)
        {
            var bytes = Utf8.GetBytes(text);
            return stream.WriteAsync(bytes, 0, bytes.Length);
        }
    }
