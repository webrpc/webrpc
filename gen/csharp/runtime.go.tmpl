    internal static class WebrpcHttp
    {
        internal static global::System.Net.Http.HttpRequestMessage NewRequest(global::System.Net.Http.HttpMethod method, string url, global::System.Net.Http.HttpContent? content)
        {
            var request = new global::System.Net.Http.HttpRequestMessage(method, url);
            request.Headers.TryAddWithoutValidation("Accept", "application/json");
            {{- if $opts.webrpcHeader }}
            request.Headers.TryAddWithoutValidation(Webrpc.Header, Webrpc.HeaderValue);
            {{- end }}
            request.Content = content;
            return request;
        }

        internal static global::System.Net.Http.HttpContent JsonContent(string json)
        {
            var content = new global::System.Net.Http.ByteArrayContent(global::System.Text.Encoding.UTF8.GetBytes(json));
            content.Headers.ContentType = new global::System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
            return content;
        }

        // Sends the request, failing with WebrpcRequestFailedException when no
        // response is received. Cancellation by the caller's token is rethrown.
        private static async global::System.Threading.Tasks.Task<global::System.Net.Http.HttpResponseMessage> SendAsync(global::System.Net.Http.HttpClient client, global::System.Net.Http.HttpRequestMessage request, global::System.Net.Http.HttpCompletionOption completionOption, global::System.Threading.CancellationToken cancellationToken)
        {
            try
            {
                return await client.SendAsync(request, completionOption, cancellationToken).ConfigureAwait(false);
            }
            catch (global::System.OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (global::System.Exception ex) when (!(ex is WebrpcException))
            {
                throw new WebrpcRequestFailedException(ex.Message, ex);
            }
        }

        // Sends a request and decodes the JSON response. A null or empty
        // response body (when allowed) decodes as the zero value.
        internal static async global::System.Threading.Tasks.Task<T> CallAsync<T>(global::System.Net.Http.HttpClient client, global::System.Net.Http.HttpRequestMessage request, bool emptyOk, global::System.Threading.CancellationToken cancellationToken)
            where T : class, new()
        {
            using (var response = await SendAsync(client, request, global::System.Net.Http.HttpCompletionOption.ResponseContentRead, cancellationToken).ConfigureAwait(false))
            {
                var status = (int)response.StatusCode;
                var body = await ReadBodyAsync(response).ConfigureAwait(false);
                if (status < 200 || status > 299)
                {
                    throw DecodeError(status, body);
                }
                if (status == 204 || status == 205 || (emptyOk && body.Trim().Length == 0))
                {
                    return new T();
                }
                try
                {
                    return WebrpcJson.Deserialize<T?>(body) ?? new T();
                }
                catch (global::System.Exception ex)
                {
                    throw new WebrpcBadResponseException("WebrpcBadResponse", "bad response", status, "failed to unmarshal JSON response body: " + ex.Message, ex);
                }
            }
        }

        // Sends a request of a method without outputs.
        internal static async global::System.Threading.Tasks.Task CallAsync(global::System.Net.Http.HttpClient client, global::System.Net.Http.HttpRequestMessage request, global::System.Threading.CancellationToken cancellationToken)
        {
            using (var response = await SendAsync(client, request, global::System.Net.Http.HttpCompletionOption.ResponseContentRead, cancellationToken).ConfigureAwait(false))
            {
                var status = (int)response.StatusCode;
                if (status < 200 || status > 299)
                {
                    throw DecodeError(status, await ReadBodyAsync(response).ConfigureAwait(false));
                }
            }
        }
